@page "/issue-270/streaming/{mode}"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.Web
@inject Issue260Gate Gate

<main data-issue-270-page="@state">@state</main>
<Issue270InteractiveChild @rendermode="SelectedMode" />

@code {
    [Parameter] public string Mode { get; set; } = "server";

    private string state = "initial";

    private IComponentRenderMode SelectedMode => Mode switch
    {
        "webassembly" => RenderMode.InteractiveWebAssembly,
        "auto" => RenderMode.InteractiveAuto,
        _ => RenderMode.InteractiveServer,
    };

    // #270's own page: Issue269StreamingPage hardcodes Issue269InteractiveChild as its child, so reusing it
    // here would require threading a child-type choice through its own parameters. This page wraps
    // Issue270InteractiveChild directly instead (see that file's own comment for why its render-mode probe is
    // a separate component rather than a parameter on the shared one). Mirrors Issue269StreamingPage's own
    // pending-gate shape so a stock oracle can pin the full-quiescence premise the exception-handler cases rely
    // on: the page's own async continuation only resolves after the test releases Issue260Gate, so a response
    // that observes "updated" proves the gated work was actually awaited before the response was produced.
    protected override async Task OnInitializedAsync()
    {
        Gate.Reached($"issue-270-page-{Mode}");
        // Task.Yield() right after Reached, as Issue260Gate's own doc comment directs: without it, a release
        // landing before this await registers lets OnInitializedAsync complete synchronously, so the test's
        // own release-then-await ordering would no longer be exercising a real pending task.
        await Task.Yield();
        await Gate.WaitForReleaseAsync($"issue-270-page-{Mode}");
        state = "updated";
    }
}
