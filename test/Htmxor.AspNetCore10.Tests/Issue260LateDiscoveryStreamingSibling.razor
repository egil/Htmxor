@attribute [StreamRendering]
@inject Issue260Gate Gate

<p data-issue-260-late-sibling="@state">@state</p>

@code {
    private string state = "sibling-initial";

    // Its own [StreamRendering] task stays pending here, so it keeps the response's full quiescence incomplete
    // after the non-streaming wait chain below finishes -- the precondition the non-streaming child needs to
    // expose the defect: without a streaming component anywhere on the page, nothing keeps quiescence
    // incomplete once that chain resolves, and the response never considers starting before full quiescence
    // at all.
    protected override async Task OnInitializedAsync()
    {
        Gate.Reached("late-sibling");
        await Gate.WaitForReleaseAsync("late-sibling");
        state = "sibling-updated";
    }
}
