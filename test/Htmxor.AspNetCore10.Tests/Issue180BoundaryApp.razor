@namespace Htmxor.Explicit.Anywhere
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
<!DOCTYPE html><html><body>
<ErrorBoundary>
    <ChildContent>
        <Router AppAssembly="typeof(Issue180BoundaryApp).Assembly">
            <Found Context="routeData"><RouteView RouteData="routeData" /></Found>
        </Router>
    </ChildContent>
    <ErrorContent><output data-boundary="fallback">The page failed.</output></ErrorContent>
</ErrorBoundary>
</body></html>
