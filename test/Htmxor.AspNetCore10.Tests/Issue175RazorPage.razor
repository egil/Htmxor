@page "/issue-175/razor"
@attribute [Htmxor.DisableHtmxDirectRouting]
@attribute [Htmxor.HtmxLayout(typeof(Issue175HtmxLayoutComponent))]
@inject Issue175ApplicationProbe Probe

<h1 data-issue-175-page="razor">Normal-only razor page</h1>
<p data-route-metadata="@RouteMetadata">@RouteMetadata</p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? RouteMetadata
        => HttpContext.GetEndpoint()?.Metadata.GetMetadata<Issue175MetadataSentinel>()?.Value;

    protected override void OnInitialized() => Probe.RecordInitialization();
}
