@page "/issue-230/action"
@inherits Issue230Carrier
@using Htmxor
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation

<main data-issue-230-action>rendered</main>
<button @onput="PutAsync">Put</button>

@code {
    [SupplyParameterFromQuery] public string? Destination { get; set; }

    // Its own page: the generated action injects an Htmxor service, so a stock host cannot render it.
    private async Task PutAsync(HtmxEventArgs _)
    {
        Write("written-action");
        await Task.Yield();
        Navigation.NavigateTo(Destination ?? "/issue-230/read");
    }
}
