@inject Issue260Gate Gate

<p data-issue-260-late-nav-child="@state">@state</p>
@if (showGrandchild)
{
    <Issue260LateNavigationGrandchild />
}

@code {
    private string state = "child-initial";
    private bool showGrandchild;

    // Deliberately does not force a synchronous re-render before returning (contrast
    // Issue260LateDiscoveryChild's own InvokeAsync(StateHasChanged) call): that would let the grandchild's own
    // pending task exist while this method's own task is still running, so it could in principle be picked up
    // by whatever captured the *first* iteration's snapshot before this task is even marked complete. Letting
    // the framework's own post-completion render reveal the grandchild instead means the grandchild cannot
    // exist until this component's own OnInitializedAsync task has already finished, so its NavigationException
    // can only ever surface from a wait that re-checks for new work after this one settles -- exactly the
    // later-iteration mechanism criterion 3's "in any iteration" protects.
    protected override async Task OnInitializedAsync()
    {
        Gate.Reached("late-nav-child");
        await Gate.WaitForReleaseAsync("late-nav-child");
        showGrandchild = true;
        state = "child-updated";
    }
}
