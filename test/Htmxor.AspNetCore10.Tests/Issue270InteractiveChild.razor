@implements IDisposable
@inject PersistentComponentState State

<p data-issue-269-child="rendered">interactive</p>
<p data-issue-269-child-render-mode="@(AssignedRenderMode?.GetType().Name ?? "none")">render-mode</p>

@code {
    private PersistingComponentStateSubscription? subscription;

    // #270's own child, kept separate from the shared Issue269InteractiveChild rather than adding a parameter
    // to it: a component's full parameter set (not only the parameters a given render actually sets) is part
    // of its WebAssembly/Auto render-mode marker payload, so adding a parameter there would have changed every
    // #269 case's marker bytes too. This child carries the same persisted-state probe #269's child carries
    // (so the whole-body and persisted-state comparisons stay meaningful) plus an always-on render-mode marker,
    // exposing ComponentBase's own AssignedRenderMode -- a value the component itself can read and branch on,
    // not only a marker in the surrounding markup.
    protected override void OnInitialized()
    {
        subscription = State.RegisterOnPersisting(() =>
        {
            State.PersistAsJson("issue269-probe", "issue269-persisted");
            return Task.CompletedTask;
        });
    }

    public void Dispose() => subscription?.Dispose();
}
