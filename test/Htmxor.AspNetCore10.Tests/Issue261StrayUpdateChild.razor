@inject Issue261NotFoundGate Gate

<p data-issue-261-stray="@RenderedState">@RenderedState</p>

@code {
    private string state = "stray-initial";

    // Read from the markup above instead of `state` directly: the renderer calls into this component's
    // generated BuildRenderTree, which evaluates this getter, only when it actually builds a new render tree
    // for this component. Recording the state here, rather than only checking whether a batch later reached
    // the wire, keeps this component's own observation independent of what later happens to that render tree
    // (sent, suppressed, or lost to an exception while sending it).
    private string RenderedState
    {
        get
        {
            Gate.RecordStrayRenderObserved(state);
            return state;
        }
    }

    protected override Task OnInitializedAsync()
    {
        // Detached on purpose: returning this task instead would make the renderer's QuiescenceTask wait for
        // it, and #261's own evidence is that an update racing *inside* that wait already streams in stock
        // too (see the issue's "Evidence: the mechanism" section) -- not the gap this case targets. A
        // genuinely untracked continuation, kicked off here and resumed only once the page's own not-found
        // has already been raised, is the shape stock's SignalRendererToFinishRendering (and the candidate's
        // missing equivalent) is supposed to govern regardless of what the renderer was or was not tracking.
        _ = DeferredUpdateAsync();
        return Task.CompletedTask;
    }

    private async Task DeferredUpdateAsync()
    {
        await Gate.StrayReleased;
        state = "stray-updated";
        try
        {
            await InvokeAsync(StateHasChanged);
            Gate.RecordStrayOutcome(null);
        }
        catch (Exception exception)
        {
            // This task is detached (see OnInitializedAsync above), so nothing else ever awaits it; without
            // this, a render attempt that throws here -- for example against an already-disposed response --
            // would become an unobserved task exception instead of a result the test can see and wait for.
            Gate.RecordStrayOutcome(exception);
        }
    }
}
