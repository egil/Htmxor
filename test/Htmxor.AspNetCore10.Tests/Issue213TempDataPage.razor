@page "/issue-213/tempdata"
@using Htmxor
@using Htmxor.Components
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation

<p data-outside="true">outside</p>
<HtmxFragment Name="message">
    <p data-message="@(Value ?? "missing")">@(Value ?? "missing")</p>
</HtmxFragment>
<form method="post" @formname="save" @onsubmit="Save"></form>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromTempData(Name = "issue213-message")] public string? Value { get; set; }
    [SupplyParameterFromQuery] public string? Change { get; set; }
    [SupplyParameterFromQuery] public string? ActionValue { get; set; }
    [SupplyParameterFromQuery] public bool Redirect { get; set; }

    protected override async Task OnInitializedAsync()
    {
        HttpContext.GetHtmxContext().Response.SelectFragment("message");
        if (Change is not null)
        {
            await Task.Yield();
            Value = Change;
        }
    }

    private void Save()
    {
        // Only the [SupplyParameterFromTempData] write, so the redirect rows prove supplier write-back
        // rather than a direct dictionary write that would persist on its own.
        Value = ActionValue;
        if (Redirect)
        {
            Navigation.NavigateTo("/issue-213/read");
        }
    }
}
