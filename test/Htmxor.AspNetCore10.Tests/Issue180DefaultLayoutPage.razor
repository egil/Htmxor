@namespace Htmxor.Explicit.Anywhere
@using Microsoft.AspNetCore.Components.Forms
@page "/issue-180/default/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<AntiforgeryToken />
<output data-owner="@InstanceId" data-id="@Id" data-result="@result"></output>
@code {
    [Microsoft.AspNetCore.Components.Inject] public Issue180DuplicateProbe Probe { get; set; } = default!;
    [Microsoft.AspNetCore.Components.Parameter] public int Id { get; set; }
    public string InstanceId { get; } = Guid.NewGuid().ToString("N");
    private string result = "GET";

    protected override void OnInitialized() => Probe.Initialize("routed", InstanceId, Id, null);

    [Htmxor.HtmxAction("POST")]
    private Task Post()
    {
        Probe.Invoke("routed", InstanceId, Id, null);
        result = "POST";
        return Task.CompletedTask;
    }
}
