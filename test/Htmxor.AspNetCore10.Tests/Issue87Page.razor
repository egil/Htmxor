@page "/issue-87/{ItemId:int}"
@attribute [Authorize(Policy = "issue-87-policy")]
@using Htmxor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject Issue87RequestProbe RequestProbe

<button hx-put="/issue-87/@ItemId?source=@Source" @onput="PutItem">Put</button>
<button hx-patch="/issue-87/@ItemId?source=@Source" @onpatch="PatchItem">Patch</button>
<button hx-delete="/issue-87/@ItemId?source=@Source" @ondelete="DeleteItem">Delete</button>
<AntiforgeryToken />

<p data-issue-87-result
   data-item-id="@ItemId"
   data-query-source="@Source"
   data-user="@HttpContext.User.Identity?.Name"
   data-request-id="@RequestProbe.Id"
   data-binding-count="@RequestProbe.BindingCount"
   data-initialization-count="@RequestProbe.InitializationCount"
   data-callback-count="@RequestProbe.CallbackCount"
   data-callback-name="@callbackName"
   data-action-completed="@actionCompleted.ToString().ToLowerInvariant()">
    @callbackObservation
</p>

@code {
    private bool actionCompleted;
    private string? callbackName;
    private string? callbackObservation;

    [Parameter]
    public int ItemId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "source")]
    public string? Source { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        RequestProbe.RecordInitialization();
    }

    protected override void OnParametersSet()
    {
        RequestProbe.RecordBinding();
    }

    private void PutItem(HtmxEventArgs _) => RecordAction("put");

    private void PatchItem(HtmxEventArgs _) => RecordAction("patch");

    private void DeleteItem(HtmxEventArgs _) => RecordAction("delete");

    private void RecordAction(string action)
    {
        actionCompleted = true;
        callbackName = action;
        callbackObservation = $"{action}|{ItemId}|{Source}|{HttpContext.User.Identity?.Name}|{RequestProbe.Value}";
        RequestProbe.RecordCallback();
    }
}
