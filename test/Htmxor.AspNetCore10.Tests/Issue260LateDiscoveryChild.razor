@inject Issue260Gate Gate

<p data-issue-260-late-child="@state">@state</p>
@if (showGrandchild)
{
    <Issue260LateGrandchild />
}

@code {
    private string state = "child-initial";
    private bool showGrandchild;

    // Not [StreamRendering], and reveals its own grandchild only once this first wait releases: the grandchild's
    // pending task cannot exist in the non-streaming wait set at the moment that set is first captured, so it is
    // "work discovered after the first wait began" (criterion 2). InvokeAsync(StateHasChanged) runs synchronously
    // here (the dispatcher is already on this call stack), so the grandchild's own OnInitializedAsync -- and the
    // pending task it adds -- run before this method itself returns, i.e. before this component's own pending
    // task completes.
    //
    // Awaits Task.Yield() right after signalling Reached: without it, a release that lands before this await
    // registers lets this whole method run to completion inside the same render pass the invoker captures its
    // first non-streaming snapshot from. The grandchild's pending task would then already be in that first
    // snapshot, so even the candidate's one-shot wait would wait for it, and the case would stop distinguishing
    // a one-shot wait from stock's loop. The yield posts the rest of this method to the renderer's dispatcher,
    // which cannot run it until that render pass has captured the snapshot and yielded, so the grandchild is
    // always discovered later, regardless of how quickly the test reacts to Reached.
    protected override async Task OnInitializedAsync()
    {
        Gate.Reached("late-child");
        await Task.Yield();
        await Gate.WaitForReleaseAsync("late-child");
        showGrandchild = true;
        state = "child-updated";
        await InvokeAsync(StateHasChanged);
    }
}
