@namespace Htmxor.Explicit.Anywhere
@using Microsoft.AspNetCore.Components.Forms
@page "/issue-180/layout/{Id:int}"
@layout Issue180RouteLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<AntiforgeryToken />
<output data-role="@Placement" data-owner="@owner" data-id="@Id" data-query="@Query" data-result="@result"></output>
@code {
    [Microsoft.AspNetCore.Components.Inject] public Issue180DuplicateProbe Probe { get; set; } = default!;
    [Microsoft.AspNetCore.Components.Parameter] public int Id { get; set; }
    [Microsoft.AspNetCore.Components.Parameter] public string Placement { get; set; } = "routed";
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    private readonly string owner = Guid.NewGuid().ToString("N");
    private string result = "GET";

    protected override void OnInitialized() => Probe.Initialize(Placement, owner, Id, Query);

    [Htmxor.HtmxAction("POST")]
    private Task Post()
    {
        Probe.Invoke(Placement, owner, Id, Query);
        result = "POST";
        return Task.CompletedTask;
    }
}
