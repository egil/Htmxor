@page "/issue-260/reexecuted-pending"
@inject Issue260Gate Gate

<main data-issue-260-reexecuted-pending="@state">@state</main>

@code {
    private string state = "reexecuted-initial";

    // Not [StreamRendering]. Re-executed by UseStatusCodePagesWithReExecute; the protected behavior is that a
    // re-executed request with non-streaming pending work still reaches the same final, quiesced output stock
    // reaches on the same target, whichever way each target's own invoker classifies pending work during
    // re-execution.
    protected override async Task OnInitializedAsync()
    {
        Gate.Reached("reexecuted-pending");
        await Gate.WaitForReleaseAsync("reexecuted-pending");
        state = "reexecuted-complete";
    }
}
