@page "/issue-260/pending-navigation"
@inject NavigationManager Navigation
@inject Issue260Gate Gate

<main data-issue-260-pending-navigation>@state</main>

@code {
    private string state = "before-navigate";

    // Not [StreamRendering]: the invoker awaits this component's non-streaming pending work before writing any
    // response. Stock's own non-streaming wait loop catches the NavigationException this raises and answers with
    // a redirect before the response starts; the default (throwing) navigation path never reaches a streaming
    // response at all here.
    //
    // Awaits Task.Yield() right after signalling Reached: without it, a release that lands before this await
    // registers lets NavigateTo run, and throw, synchronously inside the same render pass BeginRenderEndpointComponent
    // returns from. That throw is then caught by the invoker's own first-render catch (#230's bare redirect),
    // never reaching the non-streaming wait this case protects -- a false green against an unmodified candidate,
    // and a false red against a correct fix that answers an htmx request with HX-Redirect from that wait instead.
    // The yield guarantees this component's own task is still incomplete when the invoker's non-streaming wait is
    // reached, so NavigateTo always throws from within that wait, regardless of how quickly a test reacts to
    // Reached.
    protected override async Task OnInitializedAsync()
    {
        Gate.Reached("pending-navigation");
        await Task.Yield();
        await Gate.WaitForReleaseAsync("pending-navigation");
        Navigation.NavigateTo("/issue-260/destination");
        state = "updated-after-navigate";
    }
}
