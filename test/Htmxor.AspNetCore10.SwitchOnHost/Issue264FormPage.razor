@page "/issue-264/form"
@inject NavigationManager Navigation

<main data-issue-264-form-output>form</main>
<form method="post" @formname="issue-264-go" @onsubmit="Go">
    <AntiforgeryToken />
    <button type="submit">Go</button>
</form>

@code {
    [SupplyParameterFromQuery] public string? Destination { get; set; }

    private void Go() => Navigation.NavigateTo(Destination ?? "/issue-264/destination");
}
