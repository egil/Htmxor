<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<CodeMetricsProfile>tests</CodeMetricsProfile>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Alba" Version="7.4.1" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
		<PackageReference Include="xunit" Version="2.8.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="YamlDotNet" Version="16.3.0" />
	</ItemGroup>

	<!-- HtmxorExamples is the only referenced project with a top-level-statement Program,
	     so ArchiveTogglePageTests can host its real, unaliased global::Program directly. -->
	<ItemGroup>
		<ProjectReference Include="..\..\eng\Htmxor.Quality\Htmxor.Quality.csproj" />
		<ProjectReference Include="..\..\samples\HtmxorExamples\HtmxorExamples.csproj" />
	</ItemGroup>

</Project>
