@inject Issue137LifecycleProbe Probe
@inject IHttpContextAccessor HttpContextAccessor

@{
	Record("rendered");
}
<span data-issue-137-descendant="@Branch"
	  data-issue-137-request="@RequestId">@Branch descendant</span>

@code {
	[Parameter, EditorRequired]
	public required string Branch { get; set; }

	protected override void OnInitialized() => Record("initialized");

	protected override void OnParametersSet() => Record("parameters-set");

	private string RequestId => HttpContextAccessor.HttpContext!.TraceIdentifier;

	private void Record(string phase) =>
		Probe.Record(RequestId, "descendant", phase, Branch);
}
