@page "/issue-217/replacement"
@using Microsoft.AspNetCore.Components.Forms
@using Htmxor.Http
@inject Issue217Probe Probe
@inject HtmxContext Htmx

<HtmxFragment Name="form">
	<section id="form-content">
		<EditForm Model="Model" FormName="save" method="post" OnValidSubmit="Save"
			hx-post="/issue-217/replacement" hx-target="#form-slot">
			<DataAnnotationsValidator />
			<label for="name">Name</label>
			<InputText id="name" @bind-Value="Model!.Name" />
			<div id="messages"><ValidationMessage For="() => Model!.Name" /></div>
			<button type="submit">Save</button>
		</EditForm>
		<p id="result">@result</p>
	</section>
</HtmxFragment>

@code {
	[SupplyParameterFromForm] private Issue217ReplacementModel? Model { get; set; }
	private string result = "not-submitted";
	protected override void OnInitialized() => Model ??= new();
	protected override void OnParametersSet()
	{
		if (Htmx.Request.RoutingMode is RoutingMode.Direct) Htmx.Response.SelectFragment("form");
	}
	private void Save()
	{
		Probe.Callbacks.Enqueue(Model!.Name!);
		result = "saved:" + Model.Name;
	}
}
