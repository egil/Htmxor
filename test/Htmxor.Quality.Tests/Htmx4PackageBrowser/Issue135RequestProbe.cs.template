using System.Collections.Concurrent;

namespace Htmxor.Htmx4Browser;

public sealed class Issue135RequestProbe
{
	private readonly ConcurrentQueue<Issue135Observation> observations = new();

	public void RecordInitialization(string requestId) =>
		observations.Enqueue(new("initialized", requestId));

	public void RecordCallback(string requestId) =>
		observations.Enqueue(new("callback", requestId));

	public IReadOnlyList<Issue135Observation> Snapshot() => observations.ToArray();
}

public sealed record Issue135Observation(string Phase, string RequestId);
