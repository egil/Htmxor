using System.Collections.Concurrent;
using System.Net;
using Htmxor;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using Microsoft.Playwright;
using Xunit;

namespace Htmxor.Htmx4Browser;

public sealed class Issue108BrowserTests
{
	private const string EntryPath = "/issue-108";
	private const string SwapPath = "/issue-108/swap";
	private const string ApplicationHtmxPath = "/htmx-4.0.0.min.js";

	[Fact]
	public async Task Application_owned_htmx4_get_swaps_a_component_response()
	{
		await using var app = CreateApplication();
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new()
		{
			Headless = true,
		});
		await using var context = await browser.NewContextAsync(new()
		{
			BaseURL = baseAddress.AbsoluteUri,
		});
		var page = await context.NewPageAsync();
		var requests = new ConcurrentQueue<string>();
		var pageErrors = new ConcurrentQueue<string>();
		var consoleErrors = new ConcurrentQueue<string>();
		page.Request += (_, request) => requests.Enqueue(request.Url);
		page.PageError += (_, error) => pageErrors.Enqueue(error);
		page.Console += (_, message) => RecordConsoleError(message, consoleErrors);

		var navigation = await page.GotoAsync(EntryPath);
		Assert.NotNull(navigation);
		Assert.Equal((int)HttpStatusCode.OK, navigation.Status);
		var fullPageBody = await navigation.TextAsync();
		Assert.Contains("<html", fullPageBody, StringComparison.OrdinalIgnoreCase);
		Assert.Contains("data-stock-shell", fullPageBody, StringComparison.Ordinal);
		Assert.Contains("data-issue-108-page", fullPageBody, StringComparison.Ordinal);
		Assert.Equal(0, await page.Locator("meta[name='htmx-config']").CountAsync());

		await page.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");
		Assert.Equal(
			"4.0.0",
			await page.EvaluateAsync<string>("() => window.htmx.version"));
		AssertRuntimeOwnership(requests, baseAddress);

		var swapRequestTask = page.WaitForRequestAsync(IsSwapRequest);
		var swapResponseTask = page.WaitForResponseAsync(IsSwapResponse);
		await page.GetByRole(
			AriaRole.Button,
			new() { Name = "Load component", Exact = true }).ClickAsync();
		var swapRequest = await swapRequestTask;
		var swapResponse = await swapResponseTask;

		Assert.Equal((int)HttpStatusCode.OK, swapResponse.Status);
		var requestHeaders = await swapRequest.AllHeadersAsync();
		var htmxRequestHeader = Assert.Single(
			requestHeaders,
			header => string.Equals(header.Key, "HX-Request", StringComparison.OrdinalIgnoreCase));
		Assert.Equal("true", htmxRequestHeader.Value, StringComparer.OrdinalIgnoreCase);
		var directBody = await swapResponse.TextAsync();
		Assert.Contains("data-issue-108-swap", directBody, StringComparison.Ordinal);
		Assert.DoesNotContain("<html", directBody, StringComparison.OrdinalIgnoreCase);
		Assert.DoesNotContain("data-stock-shell", directBody, StringComparison.Ordinal);

		var swappedComponent = page.Locator("#issue-108-target [data-issue-108-swap]");
		await swappedComponent.WaitForAsync();
		Assert.Equal(
			"Swapped by application-owned htmx 4",
			await swappedComponent.InnerTextAsync());
		AssertRuntimeOwnership(requests, baseAddress);
		Assert.Empty(pageErrors);
		Assert.Empty(consoleErrors);
	}

	private static WebApplication CreateApplication()
	{
		var builder = WebApplication.CreateBuilder(new WebApplicationOptions
		{
			ApplicationName = typeof(Issue108BrowserTests).Assembly.GetName().Name,
			EnvironmentName = Environments.Development,
		});
		builder.WebHost.UseKestrel().UseUrls("http://127.0.0.1:0");
		builder.Logging.ClearProviders();
		builder.Services.AddRazorComponents().AddHtmx();

		var app = builder.Build();
		app.UseAntiforgery();
		app.MapStaticAssets();
		app.MapRazorComponents<Issue108App>()
			.AddHtmxorComponentEndpoints(app);

		return app;
	}

	private static void AssertRuntimeOwnership(
		IEnumerable<string> requestUrls,
		Uri baseAddress)
	{
		var uris = requestUrls.Select(url => new Uri(url)).ToArray();
		Assert.All(uris, uri => Assert.Equal(baseAddress.Authority, uri.Authority));
		Assert.Single(uris, uri => uri.AbsolutePath == ApplicationHtmxPath);
		Assert.Single(uris, uri => uri.AbsolutePath == "/_content/Htmxor/htmxor.js");
		Assert.DoesNotContain(uris, IsHtmxorRuntimeOrLegacyExtension);
	}

	private static bool IsHtmxorRuntimeOrLegacyExtension(Uri uri)
	{
		var path = uri.AbsolutePath;
		return (path.StartsWith("/_content/Htmxor/htmx", StringComparison.Ordinal) &&
			path != "/_content/Htmxor/htmxor.js") ||
			path.Contains("event-header", StringComparison.OrdinalIgnoreCase) ||
			path.Contains("compat", StringComparison.OrdinalIgnoreCase);
	}

	private static bool IsSwapRequest(IRequest request) =>
		new Uri(request.Url).AbsolutePath == SwapPath;

	private static bool IsSwapResponse(IResponse response) =>
		new Uri(response.Url).AbsolutePath == SwapPath;

	private static void RecordConsoleError(
		IConsoleMessage message,
		ConcurrentQueue<string> errors)
	{
		if (string.Equals(message.Type, "error", StringComparison.OrdinalIgnoreCase))
		{
			errors.Enqueue(message.Text);
		}
	}
}
