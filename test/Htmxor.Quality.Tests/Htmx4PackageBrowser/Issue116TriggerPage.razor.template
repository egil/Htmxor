@page "/issue-116/trigger"
@using System.Text.Json
@using Htmxor.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject HtmxContext Htmx

<main data-issue-116-trigger>
	<h1>Response trigger event</h1>
	<button id="issue-116-get" hx-get="/issue-116/trigger?updated=true" hx-target="#issue-116-target">Update</button>
	<section id="issue-116-target">
		<p class="issue-116-result" data-state="@(Updated ? "swapped" : "initial")">
			@(Updated ? "Server update complete" : "Waiting for server update")
		</p>
	</section>
</main>

@code {
	[SupplyParameterFromQuery]
	public bool Updated { get; set; }

	protected override void OnParametersSet()
	{
		if (Updated && Htmx.Request.IsHtmxRequest)
		{
			var response = Htmx.Response;
			HttpContextAccessor.HttpContext!.Response.Headers[HtmxResponseHeaderNames.Trigger] =
				"manual:event";
			response.StatusCode(System.Net.HttpStatusCode.Accepted);
			response.Trigger("issue116Duplicate", new { Version = "first" });
			response.Trigger("issue116NoDetail");
			response.Trigger("issue116Configured", new { Message = "ready", Sequence = 2 });
			response.Trigger(
				"issue116\"quoted\\path",
				new { OverrideName = "explicit" },
				new JsonSerializerOptions
				{
					PropertyNamingPolicy = null,
					WriteIndented = true,
				});
			response.Trigger("issue116Duplicate", new { Version = "last" });
		}
	}
}
