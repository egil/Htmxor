@page "/issue-154/navigation"
@using Htmxor.Http
@inject HtmxContext Htmx

@if (Operation == "swap-selection")
{
	<section data-issue-154-swap-selection-response>
		<article id="issue-154-selected-root" data-issue-154-selected>
			<strong data-issue-154-selected-child>selected response</strong>
		</article>
		<div data-issue-154-unselected>unselected response</div>
	</section>
}
else if (Operation is not null)
{
	<section data-issue-154-response="@Operation">component response @Operation</section>
}
else if (State is not null)
{
	<main data-issue-154-destination="@State">
		<h1>Navigation destination @State</h1>
	</main>
}
else
{
	<main data-issue-154-navigation>
		<h1>Issue 154 navigation responses</h1>
		<button id="issue-154-location"
				type="button"
				hx-get="/issue-154/navigation?operation=location"
				hx-target="#issue-154-target"
				hx-swap="innerHTML">Location</button>
		<button id="issue-154-redirect"
				type="button"
				hx-get="/issue-154/navigation?operation=redirect"
				hx-target="#issue-154-target"
				hx-swap="innerHTML">Redirect</button>
		<button id="issue-154-refresh"
				type="button"
				hx-get="/issue-154/navigation?operation=refresh"
				hx-target="#issue-154-target"
				hx-swap="innerHTML">Refresh</button>
		<button id="issue-154-empty"
				type="button"
				hx-get="/issue-154/navigation?operation=content-length-empty"
				hx-target="#issue-154-target">Explicit empty</button>
		<button id="issue-154-push"
				type="button"
				hx-get="/issue-154/navigation?operation=push"
				hx-target="#issue-154-target"
				hx-swap="innerHTML">Push URL</button>
		<button id="issue-154-replace"
				type="button"
				hx-get="/issue-154/navigation?operation=replace"
				hx-target="#issue-154-target"
				hx-swap="innerHTML">Replace URL</button>
		<button id="issue-154-prevent-push"
				type="button"
				hx-get="/issue-154/navigation?operation=prevent-push"
				hx-target="#issue-154-target"
				hx-swap="innerHTML"
				hx-push-url="true">Prevent push</button>
		<button id="issue-154-prevent-replace"
				type="button"
				hx-get="/issue-154/navigation?operation=prevent-replace"
				hx-target="#issue-154-target"
				hx-swap="innerHTML"
				hx-replace-url="true">Prevent replace</button>
		<button id="issue-154-swap-selection"
				type="button"
				hx-get="/issue-154/navigation?operation=swap-selection"
				hx-target="#issue-154-target"
				hx-select="[data-client-selection]"
				hx-swap="innerHTML">Override swap and selection</button>
		<section id="issue-154-target" data-state="initial">initial navigation target</section>
		<aside id="issue-154-final-target">
			<span data-issue-154-old-final>old final target</span>
		</aside>
	</main>
}

@code {
	private const string NavigationPath = "/issue-154/navigation";

	[SupplyParameterFromQuery]
	public string? Operation { get; set; }

	[SupplyParameterFromQuery]
	public string? State { get; set; }

	[CascadingParameter]
	private HttpContext HttpContext { get; set; } = default!;

	protected override void OnParametersSet()
	{
		if (Operation is null || !Htmx.Request.IsHtmxRequest)
		{
			return;
		}

		switch (Operation)
		{
			case "location":
				Htmx.Response.Location(StatePath("located"));
				break;
			case "push":
				Htmx.Response.PushUrl(StatePath("pushed"));
				break;
			case "prevent-push":
				Htmx.Response.PreventBrowserHistoryUpdate();
				break;
			case "redirect":
				Htmx.Response.Redirect(StatePath("redirected"));
				break;
			case "refresh":
				Htmx.Response.Refresh();
				break;
			case "replace":
				Htmx.Response.ReplaceUrl(StatePath("replaced"));
				break;
			case "prevent-replace":
				Htmx.Response.PreventBrowserCurrentUrlUpdate();
				break;
			case "swap-selection":
				Htmx.Response.Reswap("outerHTML");
				Htmx.Response.Retarget("#issue-154-final-target");
				Htmx.Response.Reselect("[data-issue-154-selected]");
				break;
			case "unicode-reswap":
				Htmx.Response.Reswap("café");
				break;
			case "unicode-retarget":
				Htmx.Response.Retarget("café");
				break;
			case "unicode-reselect":
				Htmx.Response.Reselect("café");
				break;
			case "chain":
				Htmx.Response.Location(StatePath("discarded-location"));
				Htmx.Response.Redirect(StatePath("discarded-redirect"));
				Htmx.Response.Refresh();
				Htmx.Response.ReplaceUrl(StatePath("discarded-replace"));
				Htmx.Response.PushUrl(StatePath("chained"));
				break;
			case "explicit-empty-push":
				Htmx.Response.EmptyBody();
				Htmx.Response.Location(StatePath("discarded-explicit-location"));
				Htmx.Response.PushUrl(StatePath("explicit-empty"));
				break;
			case "content-length-empty":
				HttpContext.Response.ContentLength = 37;
				Htmx.Response.EmptyBody();
				break;
			case "throw-without-suppression":
				throw CreateRenderFailure(Operation);
			case "throw-after-empty":
				Htmx.Response.EmptyBody();
				throw CreateRenderFailure(Operation);
			case "throw-after-location":
				Htmx.Response.Location(StatePath("discarded-error-location"));
				throw CreateRenderFailure(Operation);
			case "throw-after-redirect":
				Htmx.Response.Redirect(StatePath("discarded-error-redirect"));
				throw CreateRenderFailure(Operation);
			case "throw-after-refresh":
				Htmx.Response.Refresh();
				throw CreateRenderFailure(Operation);
		}
	}

	private static InvalidOperationException CreateRenderFailure(string operation) =>
		new($"Issue 154 render failure after '{operation}'.");

	private static string StatePath(string state) => $"{NavigationPath}?state={state}";
}
