@using Htmxor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Http
@attribute [HtmxRoute("/issue-120/enhanced/{ItemId:int}")]
@attribute [Authorize("issue-120")]
@inject IHttpContextAccessor HttpContextAccessor
@inject Issue120RequestProbe Probe
@inject Issue120RequestScope RequestScope

<section @onput="Put"
	data-issue-120-enhanced
	data-item-id="@ItemId"
	data-source="@Source"
	data-scope="@RequestScope.Value"
	data-initialized="@initialized.ToString().ToLowerInvariant()">
	@if (callback is not null)
	{
		<p id="issue-120-result"
			data-issue-120-result="@callback.ToLowerInvariant()"
			data-request-id="@requestId">@callback callback</p>
	}
</section>

@code {
	[Parameter]
	public int ItemId { get; set; }

	[SupplyParameterFromQuery]
	public string Source { get; set; } = string.Empty;

	private readonly string requestId = Guid.NewGuid().ToString("N");
	private string? callback;
	private bool initialized;

	protected override void OnInitialized()
	{
		initialized = true;
		Probe.RecordInitialization();
	}

	private void Put(HtmxEventArgs _)
	{
		callback = "PUT";
		Probe.RecordEnhancedCallback(
			callback,
			HttpContextAccessor.HttpContext!.Request.Path.Value ?? string.Empty,
			requestId,
			ItemId,
			Source,
			RequestScope.Value);
	}
}
