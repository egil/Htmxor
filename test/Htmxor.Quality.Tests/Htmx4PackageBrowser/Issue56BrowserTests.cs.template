				children: Array.from(element.children, child => child.outerHTML),
				nonWhitespaceText: Array.from(element.childNodes)
					.filter(node => node.nodeType === Node.TEXT_NODE && node.textContent.trim())
					.map(node => node.textContent.trim())
			})
			""");
		Assert.Equal(
			new[]
			{
				"<section></section>",
				"<section data-issue-135-main=\"main-updated\">Main updated</section>",
			},
			finalMain.GetProperty("children").EnumerateArray()
				.Select(value => value.GetString()).ToArray());
		Assert.Empty(finalMain.GetProperty("nonWhitespaceText").EnumerateArray());

		var finalPartial = await page.Locator("#issue-135-partial-target").EvaluateAsync<JsonElement>(
			"""
			element => ({
				children: Array.from(element.children, child => child.outerHTML),
				nonWhitespaceText: Array.from(element.childNodes)
					.filter(node => node.nodeType === Node.TEXT_NODE && node.textContent.trim())
					.map(node => node.textContent.trim())
			})
