using System.Collections.Concurrent;
using System.Net;
using Htmxor;
using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.OutputCaching;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using Microsoft.Playwright;
using Xunit;

namespace Htmxor.Htmx4Browser;

public sealed class Issue56BrowserTests
{
	private const string EntryPath = "/issue-56";
	private const string GetOnlyPath = "/issue-56/get-only";
	private const string ApplicationHtmxPath = "/htmx-4.0.0.min.js";
	private const string Issue111Path = "/issue-111";
	private const string Issue50Path = "/issue-50/cache";
	private const string Issue18Path = "/issue-18/headers";

	[Fact]
	public async Task Component_controls_dynamic_response_header_without_request_leakage()
	{
		await using var app = CreateApplication(new Issue56RequestProbe());
		await app.StartAsync();
		using var client = new HttpClient { BaseAddress = new Uri(Assert.Single(app.Urls)) };

		var requests = new[]
		{
			AssertResponseHeaderAsync(client, "da-DK", htmx: false),
			AssertResponseHeaderAsync(client, "en-GB", htmx: true),
			AssertNoResponseHeaderAsync(client, htmx: false),
			AssertResponseHeaderAsync(client, "is-IS", htmx: true),
			AssertNoResponseHeaderAsync(client, htmx: true),
			AssertResponseHeaderAsync(client, "fo-FO", htmx: false),
		};

		await Task.WhenAll(requests);
	}

	[Fact]
	public async Task Output_cache_attribute_activates_a_razor_component_endpoint()
	{
		var probe = new Issue50CacheProbe();
		await using var app = CreateApplication(new Issue56RequestProbe(), cacheProbe: probe);
		await app.StartAsync();
		using var client = new HttpClient { BaseAddress = new Uri(Assert.Single(app.Urls)) };

		using var first = await SendCacheRequestAsync(client, htmx: false);
		using var second = await SendCacheRequestAsync(client, htmx: false);
		Assert.Equal(HttpStatusCode.OK, first.StatusCode);
		Assert.Equal(HttpStatusCode.OK, second.StatusCode);
		Assert.Equal(
			await first.Content.ReadAsStringAsync(),
			await second.Content.ReadAsStringAsync());
		Assert.Equal(1, probe.RenderCount);
	}

	[Fact]
	public async Task Output_cache_keeps_full_and_direct_get_representations_distinct()
	{
		foreach (var htmxFirst in new[] { false, true })
		{
			var probe = new Issue50CacheProbe();
			await using var app = CreateApplication(new Issue56RequestProbe(), cacheProbe: probe);
			await app.StartAsync();
			using var client = new HttpClient { BaseAddress = new Uri(Assert.Single(app.Urls)) };

			var firstBody = await AssertCachedRepresentationAsync(client, htmxFirst);
			Assert.Equal(1, probe.RenderCount);
			var secondBody = await AssertCachedRepresentationAsync(client, !htmxFirst);
			Assert.Equal(2, probe.RenderCount);
			Assert.NotEqual(firstBody, secondBody);
		}
	}

	[Fact]
	public async Task Application_owned_htmx4_validates_and_swaps_unsafe_component_actions()
	{
		var probe = new Issue56RequestProbe();
		await using var app = CreateApplication(probe);
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new()
		{
			Headless = true,
		});
		await using var context = await browser.NewContextAsync(new()
		{
			BaseURL = baseAddress.AbsoluteUri,
		});
		var page = await context.NewPageAsync();
		var requests = new ConcurrentQueue<string>();
		var pageErrors = new ConcurrentQueue<string>();
		var consoleErrors = new ConcurrentQueue<string>();
		page.Request += (_, request) => requests.Enqueue(request.Url);
		page.PageError += (_, error) => pageErrors.Enqueue(error);
		page.Console += (_, message) => RecordConsoleError(message, consoleErrors);

		var navigation = await page.GotoAsync(EntryPath);
		Assert.NotNull(navigation);
		Assert.Equal((int)HttpStatusCode.OK, navigation.Status);
		var fullPageBody = await navigation.TextAsync();
		Assert.Contains("<html", fullPageBody, StringComparison.OrdinalIgnoreCase);
		Assert.Contains("data-stock-shell", fullPageBody, StringComparison.Ordinal);
		Assert.Contains("data-issue-56-page", fullPageBody, StringComparison.Ordinal);
		Assert.Equal(0, await page.Locator("meta[name='htmx-config']").CountAsync());

		await page.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");
		Assert.Equal(
			"4.0.0",
			await page.EvaluateAsync<string>("() => window.htmx.version"));
		AssertRuntimeOwnership(requests, baseAddress);
		await AssertAdapterUsesHtmx4RequestContextAsync(page);

		var baseline = probe.Snapshot();
		await page.Locator("input[name='__RequestVerificationToken']").EvaluateAsync(
			"element => element.remove()");
		await AssertRejectedAsync(page, "POST", expectedTokenHeader: false);
		Assert.Equal(baseline, probe.Snapshot());

		await page.ReloadAsync();
		baseline = probe.Snapshot();
		await page.Locator("input[name='__RequestVerificationToken']").EvaluateAsync(
			"element => element.value = 'invalid-request-token'");
		await AssertRejectedAsync(page, "PUT", expectedTokenHeader: true);
		Assert.Equal(baseline, probe.Snapshot());
		Assert.Empty(pageErrors);
		Assert.Equal(2, consoleErrors.Count);
		Assert.All(
			consoleErrors,
			error => Assert.StartsWith("Failed to load resource", error, StringComparison.Ordinal));
		consoleErrors.Clear();

		await page.ReloadAsync();
		foreach (var method in new[] { "POST", "PUT", "PATCH", "DELETE" })
		{
			await AssertSuccessfulActionAsync(page, method, probe);
		}

		var getOnlyResponse = await page.GotoAsync(GetOnlyPath);
		Assert.NotNull(getOnlyResponse);
		Assert.Equal((int)HttpStatusCode.OK, getOnlyResponse.Status);
		Assert.DoesNotContain(
			getOnlyResponse.Headers,
			header => string.Equals(header.Key, "set-cookie", StringComparison.OrdinalIgnoreCase) &&
				header.Value.Contains("HX-XSRF-TOKEN", StringComparison.Ordinal));
		AssertRuntimeOwnership(requests, baseAddress);
		Assert.Empty(pageErrors);
		Assert.Empty(consoleErrors);
	}

	[Fact]
	public async Task Application_owned_htmx4_swaps_component_owned_query_actions()
	{
		var probe = new Issue111RequestProbe();
		await using var app = CreateApplication(new Issue56RequestProbe(), probe);
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new() { Headless = true });
		await using var context = await browser.NewContextAsync(new() { BaseURL = baseAddress.AbsoluteUri });
		var page = await context.NewPageAsync();

		var navigation = await page.GotoAsync(Issue111Path);
		Assert.NotNull(navigation);
		Assert.Equal((int)HttpStatusCode.OK, navigation.Status);
		Assert.Contains("<html", await navigation.TextAsync(), StringComparison.OrdinalIgnoreCase);
		Assert.Equal(0, await page.Locator("input[name='__RequestVerificationToken']").CountAsync());
		await page.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");

		var stockResponse = await SubmitQueryAsync(page, "stock-query", Issue111Path);
		await AssertSuccessfulQueryAsync(page, stockResponse, "stock", "stock-content");
		var stockCallback = Assert.Single(
			probe.Snapshot(),
			observation => observation.Owner == "stock" && observation.Phase == "callback");
		Assert.Contains(
			probe.Snapshot(),
			observation => observation.Owner == "stock" &&
				observation.Phase == "initialized" &&
				observation.RequestId == stockCallback.RequestId);

		await page.GotoAsync(Issue111Path);
		var htmxOnlyResponse = await SubmitQueryAsync(page, "htmx-only-query", "/issue-111/htmx-only/7");
		await AssertSuccessfulQueryAsync(page, htmxOnlyResponse, "htmx-only", "htmx-only-content");
		var htmxOnlyCallback = Assert.Single(
			probe.Snapshot(),
			observation => observation.Owner == "htmx-only" && observation.Phase == "callback");
		Assert.Contains(
			probe.Snapshot(),
			observation => observation.Owner == "htmx-only" &&
				observation.Phase == "initialized" &&
				observation.RequestId == htmxOnlyCallback.RequestId);
		Assert.NotEqual(stockCallback.RequestId, htmxOnlyCallback.RequestId);

		await page.GotoAsync(Issue111Path);
		var beforeNegative = probe.Snapshot();
		var negativeResponse = await SubmitQueryAsync(page, "client-only-query", "/issue-111/no-action");
		Assert.Equal((int)HttpStatusCode.MethodNotAllowed, negativeResponse.Status);
		Assert.Equal(beforeNegative, probe.Snapshot());
	}

	private static WebApplication CreateApplication(
		Issue56RequestProbe probe,
		Issue111RequestProbe? issue111Probe = null,
		Issue50CacheProbe? cacheProbe = null)
	{
		var builder = WebApplication.CreateBuilder(new WebApplicationOptions
		{
			ApplicationName = typeof(Issue56BrowserTests).Assembly.GetName().Name,
			EnvironmentName = Environments.Development,
		});
		builder.WebHost.UseKestrel().UseUrls("http://127.0.0.1:0");
		builder.Logging.ClearProviders();
		builder.Services.AddRazorComponents().AddHtmx();
		builder.Services.AddHttpContextAccessor();
		builder.Services.AddAuthentication("Issue111")
			.AddScheme<AuthenticationSchemeOptions, Issue111AuthenticationHandler>("Issue111", _ => { });
		builder.Services.AddAuthorizationBuilder().AddPolicy("issue-111", policy => policy.RequireAuthenticatedUser());
		builder.Services.AddOutputCache();
		builder.Services.AddSingleton(probe);
		builder.Services.AddSingleton(issue111Probe ?? new Issue111RequestProbe());
		builder.Services.AddSingleton(cacheProbe ?? new Issue50CacheProbe());

		var app = builder.Build();
		app.UseAuthentication();
		app.UseAuthorization();
		app.UseAntiforgery();
		app.UseOutputCache();
		app.MapStaticAssets();
		var routes = app.MapGroup(string.Empty);
		app.MapRazorComponents<Issue56App>()
			.AddHtmxorComponentEndpoints(routes);

		return app;
	}

	private static async Task AssertResponseHeaderAsync(
		HttpClient client,
		string language,
		bool htmx)
	{
		using var response = await SendGetAsync(client, $"{Issue18Path}?language={language}", htmx);
		Assert.Equal(HttpStatusCode.OK, response.StatusCode);
		Assert.Equal(language, Assert.Single(response.Content.Headers.ContentLanguage));
		var body = await response.Content.ReadAsStringAsync();
		Assert.Equal(!htmx, body.Contains("data-stock-shell", StringComparison.Ordinal));
		Assert.Contains("data-issue-18-header", body, StringComparison.Ordinal);
		Assert.Contains("data-response-started=\"false\"", body, StringComparison.Ordinal);
	}

	private static async Task AssertNoResponseHeaderAsync(HttpClient client, bool htmx)
	{
		using var response = await SendGetAsync(client, GetOnlyPath, htmx);
		Assert.Equal(HttpStatusCode.OK, response.StatusCode);
		Assert.Empty(response.Content.Headers.ContentLanguage);
	}

	private static async Task<HttpResponseMessage> SendGetAsync(
		HttpClient client,
		string path,
		bool htmx)
	{
		using var request = new HttpRequestMessage(HttpMethod.Get, path);
		if (htmx)
		{
			request.Headers.Add("HX-Request", "true");
		}

		return await client.SendAsync(request);
	}

	private static async Task<string> AssertCachedRepresentationAsync(HttpClient client, bool htmx)
	{
		using var first = await SendCacheRequestAsync(client, htmx);
		using var second = await SendCacheRequestAsync(client, htmx);
		Assert.Equal(HttpStatusCode.OK, first.StatusCode);
		Assert.Equal(HttpStatusCode.OK, second.StatusCode);
		Assert.False(first.Headers.Contains("Set-Cookie"));
		Assert.False(second.Headers.Contains("Set-Cookie"));
		var firstBody = await first.Content.ReadAsStringAsync();
		var secondBody = await second.Content.ReadAsStringAsync();
		Assert.Equal(firstBody, secondBody);
		Assert.Equal(!htmx, firstBody.Contains("data-stock-shell", StringComparison.Ordinal));
		Assert.Contains("data-issue-50-cache", firstBody, StringComparison.Ordinal);
		return firstBody;
	}

	private static async Task<HttpResponseMessage> SendCacheRequestAsync(HttpClient client, bool htmx)
	{
		using var request = new HttpRequestMessage(HttpMethod.Get, Issue50Path);
		if (htmx)
		{
			request.Headers.Add("HX-Request", "true");
		}

		return await client.SendAsync(request);
	}

	private static async Task<IResponse> SubmitQueryAsync(
		IPage page,
		string formId,
		string expectedPath)
	{
		var responseTask = page.WaitForResponseAsync(response =>
			new Uri(response.Url).AbsolutePath == expectedPath &&
			string.Equals(response.Request.Method, "QUERY", StringComparison.Ordinal));
		await page.Locator($"#{formId} button[type='submit']").ClickAsync();
		return await responseTask;
	}

	private static async Task AssertSuccessfulQueryAsync(
		IPage page,
		IResponse response,
		string owner,
		string submittedValue)
	{
		Assert.True(
			response.Status == (int)HttpStatusCode.OK,
			$"Expected 200 for QUERY, received {response.Status}: {await response.TextAsync()}");
		var headers = await response.Request.AllHeadersAsync();
		Assert.Equal("true", headers["hx-request"], StringComparer.OrdinalIgnoreCase);
		Assert.False(headers.ContainsKey("requestverificationtoken"));
		Assert.Contains($"queryValue={submittedValue}", response.Request.PostData, StringComparison.Ordinal);
		var body = await response.TextAsync();
		Assert.DoesNotContain("<html", body, StringComparison.OrdinalIgnoreCase);
		Assert.DoesNotContain("data-stock-shell", body, StringComparison.Ordinal);
		await page.Locator($"[data-query-result='{owner}']").WaitForAsync();
		Assert.Contains(
			submittedValue,
			await page.Locator($"[data-query-result='{owner}']").TextContentAsync(),
			StringComparison.Ordinal);
	}

	private static async Task AssertRejectedAsync(
		IPage page,
		string method,
		bool expectedTokenHeader)
	{
		await SelectActionAsync(page, method);
		var responseTask = page.WaitForResponseAsync(response =>
			new Uri(response.Url).AbsolutePath == EntryPath &&
			string.Equals(response.Request.Method, method, StringComparison.Ordinal));
		await page.GetByRole(AriaRole.Button, new() { Name = "Action", Exact = true }).ClickAsync();
		var response = await responseTask;
		var headers = await response.Request.AllHeadersAsync();
		Assert.Equal(expectedTokenHeader, headers.ContainsKey("requestverificationtoken"));
		Assert.Equal((int)HttpStatusCode.BadRequest, response.Status);
	}

	private static async Task AssertSuccessfulActionAsync(
		IPage page,
		string method,
		Issue56RequestProbe probe)
	{
		var before = probe.Snapshot();
		await SelectActionAsync(page, method);
		var responseTask = page.WaitForResponseAsync(response =>
			new Uri(response.Url).AbsolutePath == EntryPath &&
			string.Equals(response.Request.Method, method, StringComparison.Ordinal));
		await page.GetByRole(AriaRole.Button, new() { Name = "Action", Exact = true }).ClickAsync();
		var response = await responseTask;
		var requestHeaders = await response.Request.AllHeadersAsync();
		Assert.Equal("true", requestHeaders["hx-request"], StringComparer.OrdinalIgnoreCase);
		Assert.True(requestHeaders.ContainsKey("requestverificationtoken"));
		Assert.True(
			response.Status == (int)HttpStatusCode.OK,
			$"Expected 200 for {method}, received {response.Status}: {await response.TextAsync()}");
		var body = await response.TextAsync();
		Assert.Contains($"data-issue-56-result=\"{method.ToLowerInvariant()}\"", body, StringComparison.Ordinal);
		Assert.DoesNotContain("<html", body, StringComparison.OrdinalIgnoreCase);
		Assert.DoesNotContain("data-stock-shell", body, StringComparison.Ordinal);
		await page.Locator($"#issue-56-target [data-issue-56-result='{method.ToLowerInvariant()}']").WaitForAsync();

		var after = probe.Snapshot();
		Assert.Equal(before.BindingCount + 1, after.BindingCount);
		Assert.Equal(before.InitializationCount + 1, after.InitializationCount);
		Assert.Equal(before.CallbackCount + 1, after.CallbackCount);
		Assert.Equal(method, after.LastCallback);
	}

	private static Task SelectActionAsync(IPage page, string method) =>
		page.Locator("form").EvaluateAsync(
			"""
			(element, selectedMethod) => {
				for (const method of ['post', 'put', 'patch', 'delete']) {
					if (method.toUpperCase() === selectedMethod) {
						element.setAttribute(`hx-${method}`, '/issue-56');
					} else {
						element.removeAttribute(`hx-${method}`);
					}
				}
			}
			""",
			method);

	private static async Task AssertAdapterUsesHtmx4RequestContextAsync(IPage page)
	{
		var headers = await page.EvaluateAsync<string?[]>(
			"""
			() => {
				const source = document.createElement('button');
				source.setAttribute('hxor-eventid', 'opaque-action-identity');
				const form = document.querySelector('form');
				form.append(source);
				const request = { method: 'POST', headers: {} };
				document.dispatchEvent(new CustomEvent('htmx:config:request', {
					detail: { ctx: { sourceElement: source, request } }
				}));
				source.remove();
				return [
					request.headers['HXOR-Event-Handler-Id'] ?? null,
					request.headers.RequestVerificationToken ?? null
				];
			}
			""");

		Assert.Equal("opaque-action-identity", headers[0]);
		Assert.False(string.IsNullOrWhiteSpace(headers[1]));
	}

	private static void AssertRuntimeOwnership(
		IEnumerable<string> requestUrls,
		Uri baseAddress)
	{
		var uris = requestUrls.Select(url => new Uri(url)).ToArray();
		Assert.All(uris, uri => Assert.Equal(baseAddress.Authority, uri.Authority));
		Assert.NotEmpty(uris.Where(uri => uri.AbsolutePath == ApplicationHtmxPath));
		Assert.NotEmpty(uris.Where(uri => uri.AbsolutePath == "/_content/Htmxor/htmxor.js"));
		Assert.DoesNotContain(uris, IsHtmxorRuntimeOrLegacyExtension);
	}

	private static bool IsHtmxorRuntimeOrLegacyExtension(Uri uri)
	{
		var path = uri.AbsolutePath;
		return (path.StartsWith("/_content/Htmxor/htmx", StringComparison.Ordinal) &&
			path != "/_content/Htmxor/htmxor.js") ||
			path.Contains("event-header", StringComparison.OrdinalIgnoreCase) ||
			path.Contains("compat", StringComparison.OrdinalIgnoreCase);
	}

	private static void RecordConsoleError(
		IConsoleMessage message,
		ConcurrentQueue<string> errors)
	{
		if (string.Equals(message.Type, "error", StringComparison.OrdinalIgnoreCase))
		{
			errors.Enqueue(message.Text);
		}
	}
}
