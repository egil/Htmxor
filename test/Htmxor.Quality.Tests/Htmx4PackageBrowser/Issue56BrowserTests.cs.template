			await ordinaryMain.EvaluateAsync<string>("element => element.outerHTML"));
	}

	[Fact]
	public async Task Navigation_response_operations_emit_one_header_and_apply_their_body_effect()
	{
		await using var app = CreateApplication(new Issue56RequestProbe());
		await app.StartAsync();
		using var client = new HttpClient { BaseAddress = new Uri(Assert.Single(app.Urls)) };
		var cases = new[]
		{
			new
			{
				Operation = "push",
				Header = "HX-Push-Url",
				Value = Issue154StatePath("pushed"),
				SuppressBody = false,
			},
			new
			{
				Operation = "prevent-push",
				Header = "HX-Push-Url",
				Value = "false",
				SuppressBody = false,
			},
			new
			{
				Operation = "redirect",
				Header = "HX-Redirect",
				Value = Issue154StatePath("redirected"),
				SuppressBody = true,
			},
			new
			{
				Operation = "refresh",
				Header = "HX-Refresh",
				Value = "true",
				SuppressBody = true,
			},
			new
			{
				Operation = "replace",
				Header = "HX-Replace-Url",
				Value = Issue154StatePath("replaced"),
				SuppressBody = false,
			},
			new
			{
				Operation = "prevent-replace",
				Header = "HX-Replace-Url",
				Value = "false",
				SuppressBody = false,
			},
			new
			{
				Operation = "explicit-empty-push",
				Header = "HX-Push-Url",
				Value = Issue154StatePath("explicit-empty"),
				SuppressBody = true,
			},
			new
			{
				Operation = "location",
				Header = "HX-Location",
				Value = Issue154StatePath("located"),
				SuppressBody = true,
			},
		};

		foreach (var testCase in cases)
		{
			using var request = CreateIssue154Request(testCase.Operation);
			using var response = await client.SendAsync(request);
			var body = await response.Content.ReadAsStringAsync();

			Assert.Equal(HttpStatusCode.OK, response.StatusCode);
			Assert.Equal(
				testCase.Value,
				Assert.Single(response.Headers.GetValues(testCase.Header)));
			Assert.Single(
				NavigationResponseHeaderNames,
				header => response.Headers.Contains(header));
			if (testCase.SuppressBody)
			{
				Assert.Equal(string.Empty, body);
			}
			else
			{
				Assert.Contains(
					$"data-issue-154-response=\"{testCase.Operation}\"",
					body,
					StringComparison.Ordinal);
			}
		}
	}

