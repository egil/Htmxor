	[Fact]
	public async Task Application_owned_htmx4_validates_and_swaps_unsafe_component_actions()
	{
		var probe = new Issue56RequestProbe();
		await using var app = CreateApplication(probe);
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new()
		{
			Headless = true,
		});
		await using var context = await browser.NewContextAsync(new()
		{
			BaseURL = baseAddress.AbsoluteUri,
		});
		var page = await context.NewPageAsync();
		var requests = new ConcurrentQueue<string>();
		var pageErrors = new ConcurrentQueue<string>();
		var consoleErrors = new ConcurrentQueue<string>();
		page.Request += (_, request) => requests.Enqueue(request.Url);
		page.PageError += (_, error) => pageErrors.Enqueue(error);
		page.Console += (_, message) => RecordConsoleError(message, consoleErrors);

		var navigation = await page.GotoAsync(EntryPath);
		Assert.NotNull(navigation);
		Assert.Equal((int)HttpStatusCode.OK, navigation.Status);
		var fullPageBody = await navigation.TextAsync();
		Assert.Contains("<html", fullPageBody, StringComparison.OrdinalIgnoreCase);
		Assert.Contains("data-stock-shell", fullPageBody, StringComparison.Ordinal);
		Assert.Contains("data-issue-56-page", fullPageBody, StringComparison.Ordinal);
		Assert.Equal(0, await page.Locator("meta[name='htmx-config']").CountAsync());

		await page.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");
		Assert.Equal(
			"4.0.0",
			await page.EvaluateAsync<string>("() => window.htmx.version"));
		AssertRuntimeOwnership(requests, baseAddress);
		await AssertAdapterUsesHtmx4RequestContextAsync(page);

		var baseline = probe.Snapshot();
		await page.Locator("input[name='__RequestVerificationToken']").EvaluateAsync(
			"element => element.remove()");
		await AssertRejectedAsync(page, "POST", expectedTokenHeader: false);
		Assert.Equal(baseline, probe.Snapshot());

		await page.ReloadAsync();
		baseline = probe.Snapshot();
		await page.Locator("input[name='__RequestVerificationToken']").EvaluateAsync(
			"element => element.value = 'invalid-request-token'");
		await AssertRejectedAsync(page, "PUT", expectedTokenHeader: true);
		Assert.Equal(baseline, probe.Snapshot());
		Assert.Empty(pageErrors);
		Assert.Equal(2, consoleErrors.Count);
		Assert.All(
			consoleErrors,
			error => Assert.StartsWith("Failed to load resource", error, StringComparison.Ordinal));
		consoleErrors.Clear();

		await page.ReloadAsync();
		foreach (var method in new[] { "POST", "PUT", "PATCH", "DELETE" })
		{
			await AssertSuccessfulActionAsync(page, method, probe);
		}

		var getOnlyResponse = await page.GotoAsync(GetOnlyPath);
		Assert.NotNull(getOnlyResponse);
		Assert.Equal((int)HttpStatusCode.OK, getOnlyResponse.Status);
		Assert.DoesNotContain(
			getOnlyResponse.Headers,
			header => string.Equals(header.Key, "set-cookie", StringComparison.OrdinalIgnoreCase) &&
				header.Value.Contains("HX-XSRF-TOKEN", StringComparison.Ordinal));
		AssertRuntimeOwnership(requests, baseAddress);
		Assert.Empty(pageErrors);
		Assert.Empty(consoleErrors);
	}

	[Fact]
	public async Task Application_owned_htmx4_swaps_component_owned_query_actions()
	{
		var probe = new Issue111RequestProbe();
		await using var app = CreateApplication(new Issue56RequestProbe(), probe);
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new() { Headless = true });
		await using var context = await browser.NewContextAsync(new()
		{
			BaseURL = baseAddress.AbsoluteUri,
			ExtraHTTPHeaders = new Dictionary<string, string>
			{
				[Issue111AuthenticationHandler.UserHeaderName] = "issue-111-user",
			},
		});
		var page = await context.NewPageAsync();

		var navigation = await page.GotoAsync(Issue111Path);
		Assert.NotNull(navigation);
		Assert.Equal((int)HttpStatusCode.OK, navigation.Status);
		Assert.Contains("<html", await navigation.TextAsync(), StringComparison.OrdinalIgnoreCase);
		Assert.Equal(0, await page.Locator("input[name='__RequestVerificationToken']").CountAsync());
		await page.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");

		var stockResponse = await SubmitQueryAsync(page, "stock-query", Issue111Path);
		await AssertSuccessfulQueryAsync(page, stockResponse, "stock", "stock-content");
		var stockCallback = Assert.Single(
			probe.Snapshot(),
			observation => observation.Owner == "stock" && observation.Phase == "callback");
		Assert.Contains(
			probe.Snapshot(),
			observation => observation.Owner == "stock" &&
				observation.Phase == "initialized" &&
				observation.RequestId == stockCallback.RequestId);

		await page.GotoAsync(Issue111Path);
		var htmxOnlyResponse = await SubmitQueryAsync(page, "htmx-only-query", "/issue-111/htmx-only/7");
		await AssertSuccessfulQueryAsync(page, htmxOnlyResponse, "htmx-only", "htmx-only-content");
		var htmxOnlyCallback = Assert.Single(
			probe.Snapshot(),
			observation => observation.Owner == "htmx-only" && observation.Phase == "callback");
		Assert.Contains(
			probe.Snapshot(),
			observation => observation.Owner == "htmx-only" &&
				observation.Phase == "initialized" &&
				observation.RequestId == htmxOnlyCallback.RequestId);
		Assert.NotEqual(stockCallback.RequestId, htmxOnlyCallback.RequestId);

		await page.GotoAsync(Issue111Path);
		var beforeNegative = probe.Snapshot();
		var negativeResponse = await SubmitQueryAsync(page, "client-only-query", "/issue-111/no-action");
		Assert.Equal((int)HttpStatusCode.MethodNotAllowed, negativeResponse.Status);
		Assert.Equal(beforeNegative, probe.Snapshot());
	}

	[Fact]
	public async Task Application_owned_htmx4_dispatches_response_event_after_visible_swap()
	{
		await using var app = CreateApplication(new Issue56RequestProbe());
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new() { Headless = true });
		await using var context = await browser.NewContextAsync(new() { BaseURL = baseAddress.AbsoluteUri });
		var page = await context.NewPageAsync();
		var navigation = await page.GotoAsync(Issue116Path);
		Assert.NotNull(navigation);
		Assert.Equal((int)HttpStatusCode.OK, navigation.Status);
		Assert.Contains("<html", await navigation.TextAsync(), StringComparison.OrdinalIgnoreCase);
		Assert.Contains("data-stock-shell", await navigation.TextAsync(), StringComparison.Ordinal);
		await page.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");
		await page.EvaluateAsync(
			"""
			() => {
				window.issue116Events = [];
				document.body.addEventListener('issue116Updated', event => {
					window.issue116Events.push({
						swapVisible: document.querySelector(".issue-116-result[data-state='swapped']") !== null,
						message: event.detail.message
					});
				});
			}
			""");

		var responseTask = page.WaitForResponseAsync(response =>
			new Uri(response.Url).AbsolutePath == Issue116Path &&
			string.Equals(response.Request.Method, "GET", StringComparison.Ordinal));
		await page.Locator("#issue-116-get").ClickAsync();
		var response = await responseTask;
		Assert.Equal((int)HttpStatusCode.OK, response.Status);
		var responseHeaders = await response.AllHeadersAsync();
		Assert.Contains("hx-trigger", responseHeaders.Keys, StringComparer.OrdinalIgnoreCase);
		Assert.DoesNotContain("hx-trigger-after-swap", responseHeaders.Keys, StringComparer.OrdinalIgnoreCase);
		Assert.DoesNotContain("hx-trigger-after-settle", responseHeaders.Keys, StringComparer.OrdinalIgnoreCase);
		Assert.DoesNotContain("<html", await response.TextAsync(), StringComparison.OrdinalIgnoreCase);
		await page.Locator(".issue-116-result[data-state='swapped']").WaitForAsync();
		await page.WaitForFunctionAsync("() => window.issue116Events.length === 1");
		Assert.True(await page.EvaluateAsync<bool>("() => window.issue116Events[0].swapVisible"));
		Assert.Equal(
			"ready",
			await page.EvaluateAsync<string>("() => window.issue116Events[0].message"));
	}

