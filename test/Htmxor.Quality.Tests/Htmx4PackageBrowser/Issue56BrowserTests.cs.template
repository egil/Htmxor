	private static async Task AssertIssue154HistoryUpdateAsync(
		IBrowser browser,
		Uri baseAddress,
		string operation,
		string header,
		string state,
		string expectedBackPath)
	{
		await using var context = await browser.NewContextAsync(new() { BaseURL = baseAddress.AbsoluteUri });
		var page = await context.NewPageAsync();
		await page.GotoAsync(Issue64Path);
		var navigation = await page.GotoAsync(Issue154Path);
		Assert.NotNull(navigation);
		Assert.Equal((int)HttpStatusCode.OK, navigation.Status);
		await page.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");
		var responseTask = WaitForIssue154ResponseAsync(page, operation);

		await page.Locator($"#issue-154-{operation}").ClickAsync();
		var response = await responseTask;

		await AssertIssue154NavigationResponseAsync(
			response,
			header,
			Issue154StatePath(state),
			suppressBody: false);
		await page.Locator($"#issue-154-target [data-issue-154-response='{operation}']").WaitForAsync();
		await page.WaitForFunctionAsync(
			$"() => location.pathname + location.search === '{Issue154StatePath(state)}'");

		await page.EvaluateAsync("() => history.back()");
		await page.WaitForFunctionAsync(
			$"() => location.pathname + location.search === '{expectedBackPath}'");
		if (string.Equals(expectedBackPath, Issue154Path, StringComparison.Ordinal))
		{
			await page.Locator("#issue-154-target[data-state='initial']").WaitForAsync();
		}
		else
		{
			await page.Locator("[data-issue-64-page]").WaitForAsync();
		}
	}

