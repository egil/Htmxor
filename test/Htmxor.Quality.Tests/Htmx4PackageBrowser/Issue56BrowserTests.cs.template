	private static async Task AssertIssue154LocationAsync(IBrowser browser, Uri baseAddress)
	{
		await using var context = await browser.NewContextAsync(new() { BaseURL = baseAddress.AbsoluteUri });
		var page = await OpenIssue154PageAsync(context);
		await page.EvaluateAsync(
			"""
			() => {
				window.issue154LocationSentinel = true;
				sessionStorage.removeItem('issue154-location-swapped');
				document.addEventListener('htmx:after:swap', () => {
					if (document.querySelector("[data-issue-154-destination='located']")) {
						sessionStorage.setItem('issue154-location-swapped', 'true');
					}
				});
			}
			""");
		var responseTask = WaitForIssue154ResponseAsync(page, "location");
		var destinationTask = WaitForIssue154DestinationAsync(page, "located");

		await page.Locator("#issue-154-location").ClickAsync();
		var response = await responseTask;
		var destination = await destinationTask;

		await AssertIssue154NavigationResponseAsync(
			response,
			"HX-Location",
			Issue154StatePath("located"),
			suppressBody: true);
		Assert.Equal((int)HttpStatusCode.OK, destination.Status);
		await page.Locator("[data-issue-154-destination='located']").WaitForAsync();
		await page.WaitForFunctionAsync(
			$"() => location.pathname + location.search === '{Issue154StatePath("located")}'");
		Assert.True(await page.EvaluateAsync<bool>("() => window.issue154LocationSentinel === true"));
		Assert.Equal(
			"true",
			await page.EvaluateAsync<string?>(
				"() => sessionStorage.getItem('issue154-location-swapped')"));
		Assert.Equal(1, await page.Locator("body[data-stock-shell]").CountAsync());
		Assert.Equal(0, await page.Locator("#issue-154-target").CountAsync());
	}

