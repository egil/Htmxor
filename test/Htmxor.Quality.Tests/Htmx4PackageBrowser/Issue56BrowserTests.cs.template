	[Fact]
	public async Task Concurrent_selected_fragment_requests_keep_lifecycle_and_swaps_request_local()
	{
		const string markerA = "request-a";
		const string markerB = "request-b";
		var probe = new Issue144ConcurrentLifecycleProbe();
		await using var app = CreateApplication(
			new Issue56RequestProbe(),
			issue144Probe: probe);
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new() { Headless = true });
		await using var context = await browser.NewContextAsync(new() { BaseURL = baseAddress.AbsoluteUri });
		var pageA = await context.NewPageAsync();
		var pageB = await context.NewPageAsync();
		await Task.WhenAll(
			AssertIssue144StockPageAsync(pageA, markerA),
			AssertIssue144StockPageAsync(pageB, markerB));
		Assert.Empty(probe.Snapshot());
		await Task.WhenAll(
			InitializeIssue144EventsAsync(pageA),
			InitializeIssue144EventsAsync(pageB));

		var gateA = probe.GetSelectedGate(markerA);
		var gateB = probe.GetSelectedGate(markerB);
		try
		{
			var responseTaskA = WaitForIssue144ResponseAsync(pageA, markerA);
			var responseTaskB = WaitForIssue144ResponseAsync(pageB, markerB);
			await Task.WhenAll(
				pageA.Locator("#issue-144-select").ClickAsync(),
				pageB.Locator("#issue-144-select").ClickAsync());
			var requestIds = await Task.WhenAll(
				probe.WaitForSelectedInitializationAsync(markerA).WaitAsync(TimeSpan.FromSeconds(30)),
				probe.WaitForSelectedInitializationAsync(markerB).WaitAsync(TimeSpan.FromSeconds(30)));
			var requestIdA = requestIds[0];
			var requestIdB = requestIds[1];
			Assert.NotEqual(requestIdA, requestIdB);
			Assert.NotEqual(gateA.Id, gateB.Id);
			Assert.NotSame(gateA, gateB);

			var bothPendingWindow = Task.Delay(TimeSpan.FromMilliseconds(500));
			Assert.Same(
				bothPendingWindow,
				await Task.WhenAny(Task.WhenAll(responseTaskA, responseTaskB), bothPendingWindow));
			Assert.False(responseTaskA.IsCompleted);
			Assert.False(responseTaskB.IsCompleted);
			await Task.WhenAll(
				AssertIssue144PendingAsync(pageA, markerA),
				AssertIssue144PendingAsync(pageB, markerB));
			Assert.False(gateA.Release.Task.IsCompleted);
			Assert.False(gateB.Release.Task.IsCompleted);
			_ = AssertIssue144BlockedObservations(
				probe.Snapshot(), markerA, requestIdA, gateA.Id);
			var blockedObservationsB = AssertIssue144BlockedObservations(
				probe.Snapshot(), markerB, requestIdB, gateB.Id);

			probe.ReleaseSelected(markerA);
			var responseA = await responseTaskA.WaitAsync(TimeSpan.FromSeconds(30));
			await AssertIssue144CompletedAsync(
				pageA, responseA, markerA, requestIdA, markerB, requestIdB);
			var completedObservationsA = AssertIssue144RequestObservations(
				probe.Snapshot(), markerA, requestIdA, gateA.Id);
			var bIsolationWindow = Task.Delay(TimeSpan.FromMilliseconds(500));
			Assert.Same(bIsolationWindow, await Task.WhenAny(responseTaskB, bIsolationWindow));
			await AssertIssue144PendingAsync(pageB, markerB);
			Assert.True(gateA.Release.Task.IsCompleted);
			Assert.False(gateB.Release.Task.IsCompleted);
			Assert.Equal(
				blockedObservationsB,
				AssertIssue144BlockedObservations(probe.Snapshot(), markerB, requestIdB, gateB.Id));

			probe.ReleaseSelected(markerB);
			var responseB = await responseTaskB.WaitAsync(TimeSpan.FromSeconds(30));
			await AssertIssue144CompletedAsync(
				pageB, responseB, markerB, requestIdB, markerA, requestIdA);
			await AssertIssue144LiveCompletionAsync(
				pageA, markerA, requestIdA, markerB, requestIdB);
			Assert.Equal(
				completedObservationsA,
				AssertIssue144RequestObservations(probe.Snapshot(), markerA, requestIdA, gateA.Id));
			AssertIssue144Observations(probe.Snapshot(), markerA, requestIdA, gateA.Id, markerB, requestIdB, gateB.Id);
		}
		finally
		{
			probe.ReleaseSelected(markerA);
			probe.ReleaseSelected(markerB);
		}
	}

	[Fact]
	public async Task Selected_async_fragment_waits_for_quiescence_before_htmx_observes_response()
	{
		var probe = new Issue139AsyncLifecycleProbe();
		await using var app = CreateApplication(
			new Issue56RequestProbe(),
			issue139Probe: probe);
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new() { Headless = true });
		await using var context = await browser.NewContextAsync(new() { BaseURL = baseAddress.AbsoluteUri });
		var page = await context.NewPageAsync();
		var navigation = await page.GotoAsync(Issue139Path);
		Assert.NotNull(navigation);
		Assert.Equal((int)HttpStatusCode.OK, navigation.Status);
		var normalBody = await navigation.TextAsync();
		Assert.Contains("<html", normalBody, StringComparison.OrdinalIgnoreCase);
		Assert.Contains("data-stock-shell", normalBody, StringComparison.Ordinal);
		Assert.Contains("data-issue-139-stock-control", normalBody, StringComparison.Ordinal);
		Assert.Contains("data-issue-139-placeholder=\"selected\"", normalBody, StringComparison.Ordinal);
		Assert.Empty(probe.Snapshot());
		await page.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");
		await page.EvaluateAsync(
			"""
			() => {
				window.issue139ResponseEvents = 0;
				window.issue139SwapEvents = 0;
				document.body.addEventListener('htmx:after:request', event => {
					if (event.detail.ctx.sourceElement.id === 'issue-139-select') {
						window.issue139ResponseEvents++;
					}
				});
				document.body.addEventListener('htmx:after:swap', event => {
					if (event.detail.ctx.sourceElement.id === 'issue-139-select') {
						window.issue139SwapEvents++;
					}
				});
			}
			""");

		var responseTask = page.WaitForResponseAsync(response =>
			new Uri(response.Url).AbsolutePath == Issue139Path &&
			string.Equals(response.Request.Method, "GET", StringComparison.Ordinal));
		await page.Locator("#issue-139-select").ClickAsync();
		var requestId = await probe.WaitForSelectedInitializationAsync().WaitAsync(TimeSpan.FromSeconds(30));
		var completedMarker = page.Locator(
			$"#issue-139-selected [data-issue-139-completed='{requestId}']");

		try
		{
			// Keep the gate closed across a bounded scheduling opportunity so a premature response becomes observable.
			// This is not a latency assertion.
			var negativeObservationWindow = Task.Delay(TimeSpan.FromMilliseconds(500));
			Assert.Same(
				negativeObservationWindow,
				await Task.WhenAny(responseTask, negativeObservationWindow));
			Assert.False(responseTask.IsCompleted);
			Assert.Equal(0, await completedMarker.CountAsync());
			Assert.Equal("Selected placeholder", await page.Locator("#issue-139-selected").TextContentAsync());
			Assert.Equal(0, await page.EvaluateAsync<int>("() => window.issue139ResponseEvents"));
			Assert.Equal(0, await page.EvaluateAsync<int>("() => window.issue139SwapEvents"));
			Assert.DoesNotContain(
				probe.Snapshot(),
				observation => string.Equals(observation.Component, "excluded", StringComparison.Ordinal));
		}
		finally
		{
			probe.ReleaseSelected();
		}

		var response = await responseTask.WaitAsync(TimeSpan.FromSeconds(30));
		probe.Record(requestId, "browser", "response-observed");
		Assert.Equal((int)HttpStatusCode.OK, response.Status);
		var requestHeaders = await response.Request.AllHeadersAsync();
		Assert.Equal("true", requestHeaders["hx-request"], StringComparer.OrdinalIgnoreCase);
		Assert.Equal("partial", requestHeaders["hx-request-type"], StringComparer.OrdinalIgnoreCase);
		Assert.Equal("div#issue-139-selected", requestHeaders["hx-target"]);
		var directBody = await response.TextAsync();
		Assert.DoesNotContain("<html", directBody, StringComparison.OrdinalIgnoreCase);
		Assert.DoesNotContain("data-stock-shell", directBody, StringComparison.Ordinal);
		Assert.DoesNotContain("data-issue-139-stock-control", directBody, StringComparison.Ordinal);
		Assert.DoesNotContain("data-issue-139-placeholder", directBody, StringComparison.Ordinal);
		Assert.DoesNotContain("data-issue-139-descendant=\"excluded\"", directBody, StringComparison.Ordinal);
		Assert.Contains($"data-issue-139-completed=\"{requestId}\"", directBody, StringComparison.Ordinal);
		var directShape = await page.EvaluateAsync<string[]>(
			"""
			body => {
				const template = document.createElement('template');
				template.innerHTML = body;
				return Array.from(template.content.childNodes)
					.filter(node => node.nodeType !== Node.TEXT_NODE || node.textContent.trim().length > 0)
					.map(node => node.nodeType === Node.ELEMENT_NODE ? node.outerHTML : node.textContent);
			}
			""",
			directBody);
		Assert.Equal(
			new[]
			{
				$"<div id=\"issue-139-selected\"><span data-issue-139-descendant=\"selected\" data-issue-139-completed=\"{requestId}\">selected completed {requestId}</span></div>",
			},
			directShape);

		await completedMarker.WaitForAsync();
		Assert.Equal($"selected completed {requestId}", await completedMarker.TextContentAsync());
		Assert.Equal(1, await page.EvaluateAsync<int>("() => window.issue139ResponseEvents"));
		Assert.Equal(1, await page.EvaluateAsync<int>("() => window.issue139SwapEvents"));
		Assert.Equal(1, await page.Locator("#issue-139-select").CountAsync());
		Assert.Equal(1, await page.Locator("#issue-139-excluded").CountAsync());

		var directObservations = probe.Snapshot();
		Assert.DoesNotContain(
			directObservations,
			observation => string.Equals(observation.Component, "excluded", StringComparison.Ordinal));
		var selectedCompletion = Assert.Single(directObservations, observation =>
			observation is { Component: "selected", Phase: "initialization-completed" });
		var browserObservation = Assert.Single(directObservations, observation =>
			observation is { Component: "browser", Phase: "response-observed" });
		Assert.True(selectedCompletion.Sequence < browserObservation.Sequence);
	}

