	[Fact]
	public async Task Forged_request_headers_do_not_grant_route_method_authorization_or_antiforgery_access()
	{
		var probe = new Issue56RequestProbe();
		await using var app = CreateApplication(probe);
		await app.StartAsync();
		using var client = new HttpClient { BaseAddress = new Uri(Assert.Single(app.Urls)) };

		foreach (var requestType in new string?[] { null, "", "unknown", "full", "partial, full" })
		{
			using var request = CreateForgedRequest(HttpMethod.Get, "/issue-111/htmx-only/7", requestType);
			request.Headers.Add(Issue111AuthenticationHandler.UserHeaderName, "issue-111-user");
			using var response = await client.SendAsync(request);
			Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
		}

		using (var request = CreateForgedRequest(HttpMethod.Delete, GetOnlyPath, "partial"))
		using (var response = await client.SendAsync(request))
		{
			Assert.Equal(HttpStatusCode.MethodNotAllowed, response.StatusCode);
		}

		using (var request = CreateForgedRequest(HttpMethod.Get, "/issue-111/htmx-only/7", "partial"))
		using (var response = await client.SendAsync(request))
		{
			Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
		}

		var beforeUnsafeRequest = probe.Snapshot();
		using (var request = CreateForgedRequest(HttpMethod.Post, EntryPath, "partial"))
		using (var response = await client.SendAsync(request))
		{
			Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
		}
		Assert.Equal(beforeUnsafeRequest, probe.Snapshot());
	}

