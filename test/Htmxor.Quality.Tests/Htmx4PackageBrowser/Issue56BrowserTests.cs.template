				.Select(value => value.GetString()).ToArray());
		Assert.Empty(finalPartial.GetProperty("nonWhitespaceText").EnumerateArray());
		Assert.Equal(0, await page.Locator("#issue-135-main-target hx-partial").CountAsync());
		Assert.Equal(0, await page.Locator("hx-partial").CountAsync());

		var successfulRequest = probe.Snapshot().Skip(beforeSuccessfulRequest.Count).ToArray();
		Assert.Collection(
			successfulRequest,
			initialization => Assert.Equal("initialized", initialization.Phase),
			callback =>
			{
				Assert.Equal("callback", callback.Phase);
				Assert.Equal(successfulRequest[0].RequestId, callback.RequestId);
			});
	}

