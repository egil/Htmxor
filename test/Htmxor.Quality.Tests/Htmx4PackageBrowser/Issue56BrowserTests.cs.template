	[Fact]
	public async Task Htmx_only_int_route_converts_direct_get_and_rejects_invalid_value()
	{
		var probe = new Issue120RequestProbe();
		await using var app = CreateApplication(new Issue56RequestProbe(), issue120Probe: probe);
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));
		using var client = new HttpClient { BaseAddress = baseAddress };

		using var normalRequest = new HttpRequestMessage(HttpMethod.Get, Issue120EnhancedPath);
		normalRequest.Headers.Add(Issue111AuthenticationHandler.UserHeaderName, "issue-120-user");
		using var normalResponse = await client.SendAsync(normalRequest);
		Assert.Equal(HttpStatusCode.NotFound, normalResponse.StatusCode);

		using var validRequest = CreateIssue120DirectGet("/issue-120/enhanced/23?source=from-direct-get");
		using var validResponse = await client.SendAsync(validRequest);
		var validBody = await validResponse.Content.ReadAsStringAsync();
		Assert.True(
			validResponse.StatusCode == HttpStatusCode.OK,
			$"Expected 200, received {(int)validResponse.StatusCode}: {validBody}");
		Assert.Contains("data-item-id=\"23\"", validBody, StringComparison.Ordinal);
		Assert.Contains("data-source=\"from-direct-get\"", validBody, StringComparison.Ordinal);
		Assert.Contains("data-initialized=\"true\"", validBody, StringComparison.Ordinal);
		Assert.Matches("data-scope=\"[a-f0-9]{32}\"", validBody);
		Assert.DoesNotContain("data-stock-shell", validBody, StringComparison.Ordinal);
		Assert.Equal(1, probe.InitializationCount);
		Assert.Empty(probe.Snapshot());

		using var invalidRequest = CreateIssue120DirectGet("/issue-120/enhanced/not-an-int?source=rejected");
		using var invalidResponse = await client.SendAsync(invalidRequest);
		Assert.Equal(HttpStatusCode.NotFound, invalidResponse.StatusCode);
		Assert.Equal(1, probe.InitializationCount);
		Assert.Empty(probe.Snapshot());
	}

	[Fact]
	public async Task Progressive_enhancement_preserves_native_post_and_htmx_put_paths()
	{
		var probe = new Issue120RequestProbe();
		await using var app = CreateApplication(new Issue56RequestProbe(), issue120Probe: probe);
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new() { Headless = true });
		await using var noScriptContext = await browser.NewContextAsync(new()
		{
			BaseURL = baseAddress.AbsoluteUri,
			JavaScriptEnabled = false,
		});
		var noScriptPage = await noScriptContext.NewPageAsync();
		var nativeGet = await noScriptPage.GotoAsync(Issue120NativePath);
		Assert.NotNull(nativeGet);
		Assert.Equal((int)HttpStatusCode.OK, nativeGet.Status);
		Assert.Contains("data-stock-shell", await nativeGet.TextAsync(), StringComparison.Ordinal);
		var nativeForm = noScriptPage.Locator("#issue-120-form");
		Assert.Equal(Issue120NativePath, await nativeForm.GetAttributeAsync("action"));
		Assert.Equal(Issue120EnhancedAction, await nativeForm.GetAttributeAsync("hx-action"));

		var nativeResponseTask = noScriptPage.WaitForResponseAsync(response =>
			new Uri(response.Url).AbsolutePath == Issue120NativePath &&
			string.Equals(response.Request.Method, "POST", StringComparison.Ordinal));
		await noScriptPage.GetByRole(AriaRole.Button, new() { Name = "Save progressively", Exact = true })
			.ClickAsync();
		var nativeResponse = await nativeResponseTask;
		Assert.Equal((int)HttpStatusCode.OK, nativeResponse.Status);
		var nativeBody = await nativeResponse.TextAsync();
		Assert.Contains("<html", nativeBody, StringComparison.OrdinalIgnoreCase);
		Assert.Contains("data-stock-shell", nativeBody, StringComparison.Ordinal);
		var nativeCallback = Assert.Single(probe.Snapshot());
		Assert.Equal("native", nativeCallback.Owner);
		Assert.Equal("POST", nativeCallback.Method);
		Assert.Equal(Issue120NativePath, nativeCallback.Path);
		Assert.Contains("data-issue-120-result=\"post\"", nativeBody, StringComparison.Ordinal);
		Assert.Equal(Issue120NativePath, new Uri(noScriptPage.Url).AbsolutePath);

		await using var htmxContext = await browser.NewContextAsync(new()
		{
			BaseURL = baseAddress.AbsoluteUri,
			ExtraHTTPHeaders = new Dictionary<string, string>
			{
				[Issue111AuthenticationHandler.UserHeaderName] = "issue-120-user",
			},
		});
		var htmxPage = await htmxContext.NewPageAsync();
		var enhancedGet = await htmxPage.GotoAsync(Issue120NativePath);
		Assert.NotNull(enhancedGet);
		Assert.Equal((int)HttpStatusCode.OK, enhancedGet.Status);
		await htmxPage.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");
		var enhancedForm = htmxPage.Locator("#issue-120-form");
		Assert.Equal(Issue120NativePath, await enhancedForm.GetAttributeAsync("action"));
		Assert.Equal(Issue120EnhancedAction, await enhancedForm.GetAttributeAsync("hx-action"));

		var enhancedResponseTask = htmxPage.WaitForResponseAsync(response =>
			new Uri(response.Url).AbsolutePath == Issue120EnhancedPath &&
			string.Equals(response.Request.Method, "PUT", StringComparison.Ordinal));
		await htmxPage.GetByRole(AriaRole.Button, new() { Name = "Save progressively", Exact = true })
			.ClickAsync();
		var enhancedResponse = await enhancedResponseTask;
		Assert.Equal((int)HttpStatusCode.OK, enhancedResponse.Status);
		var enhancedHeaders = await enhancedResponse.Request.AllHeadersAsync();
		Assert.Equal("true", enhancedHeaders["hx-request"], StringComparer.OrdinalIgnoreCase);
		Assert.Equal("partial", enhancedHeaders["hx-request-type"], StringComparer.OrdinalIgnoreCase);
		Assert.True(enhancedHeaders.ContainsKey("requestverificationtoken"));
		var enhancedBody = await enhancedResponse.TextAsync();
		Assert.DoesNotContain("<html", enhancedBody, StringComparison.OrdinalIgnoreCase);
		Assert.DoesNotContain("data-stock-shell", enhancedBody, StringComparison.Ordinal);
		Assert.Contains("data-issue-120-result=\"put\"", enhancedBody, StringComparison.Ordinal);
		Assert.Contains("data-item-id=\"23\"", enhancedBody, StringComparison.Ordinal);
		Assert.Contains("data-source=\"from-enhanced-action\"", enhancedBody, StringComparison.Ordinal);
		Assert.Contains("data-initialized=\"true\"", enhancedBody, StringComparison.Ordinal);
		await htmxPage.Locator("#issue-120-target [data-issue-120-result='put']").WaitForAsync();
		Assert.Equal(Issue120NativePath, new Uri(htmxPage.Url).AbsolutePath);

		var callbacks = probe.Snapshot();
		Assert.Equal(2, callbacks.Count);
		var enhancedCallback = Assert.Single(callbacks, callback => callback.Method == "PUT");
		Assert.Equal("enhanced", enhancedCallback.Owner);
		Assert.Equal(Issue120EnhancedPath, enhancedCallback.Path);
		Assert.Equal(23, enhancedCallback.ItemId);
		Assert.Equal("from-enhanced-action", enhancedCallback.Source);
		Assert.NotNull(enhancedCallback.Scope);
		Assert.Contains($"data-scope=\"{enhancedCallback.Scope}\"", enhancedBody, StringComparison.Ordinal);
		Assert.NotEqual(nativeCallback.RequestId, enhancedCallback.RequestId);
	}

