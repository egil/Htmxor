	private static WebApplication CreateApplication(
		Issue56RequestProbe probe,
		Issue111RequestProbe? issue111Probe = null,
		Issue50CacheProbe? cacheProbe = null,
		Issue18HeaderProbe? issue18Probe = null,
		Issue120RequestProbe? issue120Probe = null,
		Issue129RequestProbe? issue129Probe = null,
		Issue131RequestProbe? issue131Probe = null,
		Issue133RequestProbe? issue133Probe = null,
		Issue135RequestProbe? issue135Probe = null,
		Issue137LifecycleProbe? issue137Probe = null,
		Issue139AsyncLifecycleProbe? issue139Probe = null,
		Issue144ConcurrentLifecycleProbe? issue144Probe = null,
		bool useHtmxor = true)
	{
		var builder = WebApplication.CreateBuilder(new WebApplicationOptions
		{
			ApplicationName = typeof(Issue56BrowserTests).Assembly.GetName().Name,
			ContentRootPath = AppContext.BaseDirectory,
		});
		builder.WebHost.UseKestrel().UseUrls("http://127.0.0.1:0");
		builder.Logging.ClearProviders();
		var components = builder.Services.AddRazorComponents();
		builder.Services.ConfigureHttpJsonOptions(options =>
			options.SerializerOptions.PropertyNamingPolicy = JsonNamingPolicy.CamelCase);
		if (useHtmxor)
		{
			components.AddHtmxor();
		}
		builder.Services.AddHttpContextAccessor();
		builder.Services.AddAuthentication("Issue111")
			.AddScheme<AuthenticationSchemeOptions, Issue111AuthenticationHandler>("Issue111", _ => { });
		builder.Services.AddAuthorizationBuilder()
			.AddPolicy("issue-111", policy => policy.RequireAuthenticatedUser())
			.AddPolicy("issue-120", policy => policy.RequireAuthenticatedUser())
			.AddPolicy("issue-131", policy => policy.RequireAuthenticatedUser())
			.AddPolicy("issue-133", policy => policy.RequireAuthenticatedUser())
			.AddPolicy("issue-135", policy => policy.RequireAuthenticatedUser());
		builder.Services.AddOutputCache();
		builder.Services.AddSingleton(probe);
		builder.Services.AddSingleton(issue111Probe ?? new Issue111RequestProbe());
		builder.Services.AddSingleton(cacheProbe ?? new Issue50CacheProbe());
		builder.Services.AddSingleton(issue18Probe ?? new Issue18HeaderProbe(1));
		builder.Services.AddSingleton(issue120Probe ?? new Issue120RequestProbe());
		builder.Services.AddSingleton(issue129Probe ?? new Issue129RequestProbe());
		builder.Services.AddSingleton(issue131Probe ?? new Issue131RequestProbe());
		builder.Services.AddSingleton(issue133Probe ?? new Issue133RequestProbe());
		builder.Services.AddSingleton(issue135Probe ?? new Issue135RequestProbe());
		builder.Services.AddSingleton(issue137Probe ?? new Issue137LifecycleProbe());
		builder.Services.AddSingleton(issue139Probe ?? new Issue139AsyncLifecycleProbe());
		builder.Services.AddSingleton(issue144Probe ?? new Issue144ConcurrentLifecycleProbe());
		builder.Services.AddScoped<Issue120RequestScope>();

		var app = builder.Build();
		Assert.True(app.Environment.IsProduction());
		app.UseExceptionHandler("/issue-154/error", createScopeForErrors: true);
		app.UseAuthentication();
		app.UseAuthorization();
		app.UseAntiforgery();
		app.UseOutputCache();
		app.MapStaticAssets();
		if (useHtmxor)
		{
			app.MapRazorComponents<Issue56App>()
				.AddHtmxorEndpoints();
		}
		else
		{
			app.MapRazorComponents<StockApp>();
		}

		return app;
	}

	private static async Task<string> GetStockCssPathAsync()
	{
		await using var stock = CreateApplication(new Issue56RequestProbe(), useHtmxor: false);
		await stock.StartAsync();
		var baseAddress = new Uri(Assert.Single(stock.Urls));
		using var client = new HttpClient { BaseAddress = baseAddress };
		using var response = await client.GetAsync(StockPath);
		var body = await response.Content.ReadAsStringAsync();
		Assert.True(
			response.StatusCode == HttpStatusCode.OK,
			$"Expected stock 200, received {(int)response.StatusCode}: {body}");
		Assert.Contains("data-stock-control", body, StringComparison.Ordinal);
		var match = System.Text.RegularExpressions.Regex.Match(
			body,
			"href=\"(?<path>app\\.[a-z0-9]+\\.css)\"",
			System.Text.RegularExpressions.RegexOptions.CultureInvariant);
		Assert.True(match.Success, body);
		var path = new Uri(baseAddress, match.Groups["path"].Value).AbsolutePath;
		await AssertPublishedAssetAsync(client, path, "issue-75-production-asset");
		return path;
	}

