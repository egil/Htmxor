	[Fact]
	public async Task Production_publish_preserves_stock_fingerprinted_assets_and_direct_component_get()
	{
		var stockCssPath = await GetStockCssPathAsync();
		await using var app = CreateApplication(new Issue56RequestProbe());
		await app.StartAsync();
		var baseAddress = new Uri(Assert.Single(app.Urls));
		using var client = new HttpClient { BaseAddress = baseAddress };

		using var playwright = await Playwright.CreateAsync();
		await using var browser = await playwright.Chromium.LaunchAsync(new() { Headless = true });
		await using var context = await browser.NewContextAsync(new() { BaseURL = baseAddress.AbsoluteUri });
		var page = await context.NewPageAsync();
		var navigation = await page.GotoAsync(EntryPath);
		Assert.NotNull(navigation);
		Assert.Equal((int)HttpStatusCode.OK, navigation.Status);
		Assert.Contains("data-stock-shell", await navigation.TextAsync(), StringComparison.Ordinal);

		var cssHref = await page.Locator("link[rel='stylesheet']").GetAttributeAsync("href");
		var htmxorCssPath = new Uri(baseAddress, Assert.IsType<string>(cssHref)).AbsolutePath;
		Assert.Equal(stockCssPath, htmxorCssPath);
		await AssertPublishedAssetAsync(client, htmxorCssPath, "issue-75-production-asset");
		await AssertPublishedAssetAsync(client, AdapterPath, "htmx:config:request");
		await page.WaitForFunctionAsync("() => window.htmx?.version === '4.0.0'");

		var directResponseTask = page.WaitForResponseAsync(response =>
			new Uri(response.Url).AbsolutePath == GetOnlyPath &&
			string.Equals(response.Request.Method, "GET", StringComparison.Ordinal));
		await page.Locator("#issue-75-get").ClickAsync();
		var directResponse = await directResponseTask;
		Assert.Equal((int)HttpStatusCode.OK, directResponse.Status);
		Assert.Equal(
			"true",
			(await directResponse.Request.AllHeadersAsync())["hx-request"],
			StringComparer.OrdinalIgnoreCase);
		Assert.DoesNotContain("<html", await directResponse.TextAsync(), StringComparison.OrdinalIgnoreCase);
		await page.Locator("#issue-75-target [data-issue-56-get-only]").WaitForAsync();
	}

