using System.Net;
using Xunit;
using Xunit.Abstractions;

namespace Htmxor.PackageConsumer;

public sealed class Issue291StatusCodeTests(ITestOutputHelper output)
{
    [Fact]
    public async Task Packed_status_component_route_is_discovered()
    {
        await using var host = await Issue291Host.StartAsync();
        var response = await host.GetAsync("Status=200", true, output);
        Assert.Equal(HttpStatusCode.OK, response.Status);
    }
}
