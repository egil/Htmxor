using System.Net;
using System.Net.Http;
using System.Security.Claims;
using System.Text.Encodings.Web;
using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.TestHost;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;
using Xunit;

namespace Htmxor.PackageConsumer;

/// <summary>
/// #284's main evidence: an <c>HtmxRoute</c> component's direct request is authorized exactly as
/// a stock <c>@page</c> with the same authorization metadata, across every accepted shape, three
/// users, and with and without the application's <c>FallbackPolicy</c>. Real authentication and
/// authorization middleware run in-process, driven by a request header, exactly as the rest of
/// this suite's security fixtures do. Every cell also sends the stock twin's request with HTMX
/// headers present, pinning that those headers never change the authorized outcome.
/// </summary>
public sealed class Issue284AuthorizationParityTests : IAsyncLifetime
{
	private Issue284TestHost noFallbackHost = default!;
	private Issue284TestHost fallbackHost = default!;

	private static readonly string[] Shapes =
		["none", "bare", "policy", "roles", "schemes", "two", "inherited", "anonymous"];

	private static readonly string?[] Users =
		[null, Issue284AuthenticationHandler.LimitedUser, Issue284AuthenticationHandler.FullUser];

	private static readonly Dictionary<string, (string Htmx, string Stock)> Paths = new()
	{
		["none"] = ("/issue-284/none/htmx/1", "/issue-284/none/stock/1"),
		["bare"] = ("/issue-284/bare/htmx/1", "/issue-284/bare/stock/1"),
		["policy"] = ("/issue-284/policy/htmx/1", "/issue-284/policy/stock/1"),
		["roles"] = ("/issue-284/roles/htmx/1", "/issue-284/roles/stock/1"),
		["schemes"] = ("/issue-284/schemes/htmx/1", "/issue-284/schemes/stock/1"),
		["two"] = ("/issue-284/two/htmx/1", "/issue-284/two/stock/1"),
		["inherited"] = ("/issue-284/inherited/htmx/1", "/issue-284/inherited/stock/1"),
		["anonymous"] = ("/issue-284/anonymous/htmx/1", "/issue-284/anonymous/stock/1"),
	};

	public async Task InitializeAsync()
	{
		noFallbackHost = await Issue284TestHost.CreateAsync(useFallbackPolicy: false);
		fallbackHost = await Issue284TestHost.CreateAsync(useFallbackPolicy: true);
	}

	public static IEnumerable<object[]> Cells()
	{
		foreach (var useFallbackPolicy in new[] { false, true })
		{
			foreach (var shape in Shapes)
			{
				foreach (var user in Users)
				{
					yield return new object[] { useFallbackPolicy, shape, user! };
				}
			}
		}
	}

	[Theory]
	[MemberData(nameof(Cells))]
	public async Task Htmx_route_matches_its_stock_twin_and_htmx_headers_never_change_the_outcome(
		bool useFallbackPolicy,
		string shape,
		string? user)
	{
		var expected = (int)ExpectedStatus(shape, useFallbackPolicy, user);
		var host = useFallbackPolicy ? fallbackHost : noFallbackHost;
		var (htmxPath, stockPath) = Paths[shape];

		using var stockPlain = await SendAsync(host, stockPath, user, direct: false);
		using var stockDirect = await SendAsync(host, stockPath, user, direct: true);
		using var htmxDirect = await SendAsync(host, htmxPath, user, direct: true);

		Assert.True(
			expected == (int)stockPlain.StatusCode,
			$"Stock '{shape}' (fallback={useFallbackPolicy}, user={user ?? "anonymous"}) expected {expected}, got {(int)stockPlain.StatusCode}.");
		Assert.True(
			expected == (int)stockDirect.StatusCode,
			$"Stock '{shape}' with HTMX headers (fallback={useFallbackPolicy}, user={user ?? "anonymous"}) expected {expected}, got {(int)stockDirect.StatusCode}; HTMX headers must never change the authorized outcome.");
		Assert.True(
			expected == (int)htmxDirect.StatusCode,
			$"HtmxRoute twin of '{shape}' (fallback={useFallbackPolicy}, user={user ?? "anonymous"}) expected {expected}, got {(int)htmxDirect.StatusCode}; it must match its stock twin.");
	}

	/// <summary>
	/// "none" is the only shape whose outcome depends on <c>FallbackPolicy</c>: every other shape
	/// carries explicit authorization (or <c>AllowAnonymous</c>) metadata, which ASP.NET Core
	/// always evaluates ahead of the fallback.
	/// </summary>
	private static HttpStatusCode ExpectedStatus(string shape, bool useFallbackPolicy, string? user)
	{
		if (shape == "anonymous")
		{
			return HttpStatusCode.OK;
		}

		if (shape == "bare" || shape == "schemes")
		{
			return user is null ? HttpStatusCode.Unauthorized : HttpStatusCode.OK;
		}

		if (shape == "none" && !useFallbackPolicy)
		{
			return HttpStatusCode.OK;
		}

		// "policy", "roles", "two", "inherited", and fallback-protected "none" all require the
		// same claim.
		return user switch
		{
			null => HttpStatusCode.Unauthorized,
			Issue284AuthenticationHandler.LimitedUser => HttpStatusCode.Forbidden,
			_ => HttpStatusCode.OK,
		};
	}

	private static async Task<HttpResponseMessage> SendAsync(
		Issue284TestHost host,
		string path,
		string? user,
		bool direct)
	{
		using var request = new HttpRequestMessage(HttpMethod.Get, path);
		if (direct)
		{
			request.Headers.Add("HX-Request", "true");
			request.Headers.Add("HX-Request-Type", "partial");
		}

		if (user is not null)
		{
			request.Headers.Add(Issue284AuthenticationHandler.UserHeaderName, user);
		}

		return await host.Client.SendAsync(request);
	}

	public async Task DisposeAsync()
	{
		await noFallbackHost.DisposeAsync();
		await fallbackHost.DisposeAsync();
	}
}

internal sealed class Issue284TestHost : IAsyncDisposable
{
	public WebApplication App { get; }

	public HttpClient Client { get; }

	private Issue284TestHost(WebApplication app, HttpClient client)
	{
		App = app;
		Client = client;
	}

	public static async Task<Issue284TestHost> CreateAsync(bool useFallbackPolicy)
	{
		var builder = WebApplication.CreateBuilder(new WebApplicationOptions
		{
			ApplicationName = typeof(Issue284TestHost).Assembly.GetName().Name,
			EnvironmentName = Environments.Development,
		});
		builder.WebHost.UseTestServer();
		builder.Logging.ClearProviders();
		builder.Services.AddAuthentication(Issue284AuthenticationHandler.SchemeName)
			.AddScheme<AuthenticationSchemeOptions, Issue284AuthenticationHandler>(
				Issue284AuthenticationHandler.SchemeName,
				_ => { });
		builder.Services.AddAuthorization(options =>
		{
			options.AddPolicy(
				Issue284Policy.Name,
				policy => policy.RequireClaim(Issue284Policy.ClaimType, Issue284Policy.ClaimValue));
			if (useFallbackPolicy)
			{
				options.FallbackPolicy = new AuthorizationPolicyBuilder()
					.RequireClaim(Issue284Policy.ClaimType, Issue284Policy.ClaimValue)
					.Build();
			}
		});
		builder.Services.AddRazorComponents().AddHtmxor();

		var app = builder.Build();
		app.UseAuthentication();
		app.UseAuthorization();
		app.UseAntiforgery();
		app.MapRazorComponents<Issue284App>().AddHtmxorEndpoints();

		await app.StartAsync();
		return new Issue284TestHost(app, app.GetTestClient());
	}

	public async ValueTask DisposeAsync()
	{
		Client.Dispose();
		await App.DisposeAsync();
	}
}

internal sealed class Issue284AuthenticationHandler(
	IOptionsMonitor<AuthenticationSchemeOptions> options,
	ILoggerFactory logger,
	UrlEncoder encoder)
	: AuthenticationHandler<AuthenticationSchemeOptions>(options, logger, encoder)
{
	public const string SchemeName = "issue-284-test";
	public const string UserHeaderName = "X-Issue-284-User";
	public const string LimitedUser = "limited-user";
	public const string FullUser = "full-user";

	protected override Task<AuthenticateResult> HandleAuthenticateAsync()
	{
		if (!Request.Headers.TryGetValue(UserHeaderName, out var userHeader))
		{
			return Task.FromResult(AuthenticateResult.NoResult());
		}

		var ticket = new AuthenticationTicket(CreatePrincipal(userHeader.ToString()), SchemeName);
		return Task.FromResult(AuthenticateResult.Success(ticket));
	}

	/// <summary>
	/// Shared with <c>Issue284UnsafeActionOrderingTests</c>'s synthetic antiforgery-token context,
	/// so a manufactured token is scoped to exactly the identity the real request later presents.
	/// </summary>
	public static ClaimsPrincipal CreatePrincipal(string user)
	{
		var claims = new List<Claim>
		{
			new(ClaimTypes.NameIdentifier, user),
			new(ClaimTypes.Name, user),
		};
		if (string.Equals(user, FullUser, StringComparison.Ordinal))
		{
			claims.Add(new Claim(Issue284Policy.ClaimType, Issue284Policy.ClaimValue));
			claims.Add(new Claim(ClaimTypes.Role, Issue284Policy.Role));
		}

		return new ClaimsPrincipal(new ClaimsIdentity(claims, SchemeName));
	}
}
