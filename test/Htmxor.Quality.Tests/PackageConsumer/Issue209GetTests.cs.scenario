using System.Net;
using System.Reflection;
using System.Security.Claims;
using Htmxor;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Components;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.TestHost;
using Microsoft.Extensions.DependencyInjection;
using Xunit;

namespace Htmxor.PackageConsumer;

public sealed class Issue209GetTests
{
    [Fact]
    public void Consumer_executes_the_selected_framework_runtime()
    {
#if NET11_0
        const string expected = "11.0.0-rc.2.26504.105";
#else
        const string expected = "10.0.13";
#endif
        Assert.StartsWith(expected, typeof(ComponentBase).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()!.InformationalVersion);
        Assert.StartsWith(expected, typeof(object).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()!.InformationalVersion);
    }

    [Fact]
    public async Task Packaged_generator_discovers_a_typed_GET()
    {
        await using var app = await StartAsync(true);
        using var client = app.GetTestClient();
        using var first = DirectRequest("/reports/42?Count=7");
        first.Headers.Add("X-Probe", "first");
        using var firstResponse = await client.SendAsync(first);
        Assert.Equal(HttpStatusCode.OK, firstResponse.StatusCode);
        Assert.Equal("<output>42|7|first</output>", await firstResponse.Content.ReadAsStringAsync());
    }

    private static HttpRequestMessage DirectRequest(string path)
    {
        var request = new HttpRequestMessage(HttpMethod.Get, path);
        request.Headers.Add("HX-Request", "true");
        request.Headers.Add("HX-Request-Type", "partial");
        return request;
    }

    private static async Task<WebApplication> StartAsync(bool useHtmxor)
    {
        var builder = WebApplication.CreateBuilder();
        builder.WebHost.UseTestServer();
        builder.Services.AddScoped<Issue209RequestProbe>();
        builder.Services.AddAuthentication();
        builder.Services.AddAuthorization(options => options.AddPolicy("package-reader", policy => policy.RequireAuthenticatedUser()));
        var components = builder.Services.AddRazorComponents();
        if (useHtmxor) components.AddHtmxor();
        var app = builder.Build();
        app.Use(async (context, next) =>
        {
            context.User = new ClaimsPrincipal(new ClaimsIdentity([new Claim(ClaimTypes.Name, "package-reader")], "test"));
            context.RequestServices.GetRequiredService<Issue209RequestProbe>().Value = context.Request.Headers["X-Probe"].ToString();
            await next(context);
        });
        app.UseAuthorization();
        app.UseAntiforgery();
        var endpoints = app.MapRazorComponents<Issue209App>();
        if (useHtmxor) endpoints.AddHtmxorEndpoints();
        await app.StartAsync();
        return app;
    }
}

public sealed class Issue209RequestProbe
{
    public string Value { get; set; } = "";
}
