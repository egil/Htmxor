// Shape: two [Authorize] attributes -- both the role and the policy must hold.
[HtmxRoute("/issue-284/two/htmx/{Id:int}", Methods = ["GET"])]
[Authorize(Roles = Issue284Policy.Role)]
[Authorize(Policy = Issue284Policy.Name)]
public sealed class Issue284TwoHtmxPage : ComponentBase
{
