// Shape: [Authorize(Policy = ...)] inherited from a base component.
[Authorize(Policy = Issue284Policy.Name)]
public abstract class Issue284InheritedHtmxBase : ComponentBase;

[HtmxRoute("/issue-284/inherited/htmx/{Id:int}", Methods = ["GET"])]
public sealed class Issue284InheritedHtmxPage : Issue284InheritedHtmxBase
{
	[Parameter]
	public int Id { get; set; }

	protected override void BuildRenderTree(RenderTreeBuilder builder) => Issue284Markup.Render(builder);
}

[Authorize(Policy = Issue284Policy.Name)]
public abstract class Issue284InheritedStockBase : ComponentBase;

[Route("/issue-284/inherited/stock/{Id:int}")]
public sealed class Issue284InheritedStockPage : Issue284InheritedStockBase
{
	[Parameter]
	public int Id { get; set; }

	protected override void BuildRenderTree(RenderTreeBuilder builder) => Issue284Markup.Render(builder);
}

