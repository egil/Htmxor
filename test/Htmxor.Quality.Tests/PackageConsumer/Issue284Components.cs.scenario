using Htmxor;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Components;
using Microsoft.AspNetCore.Components.Rendering;
using Microsoft.AspNetCore.Routing;

namespace Htmxor.PackageConsumer;

/// <summary>
/// #284's eight accepted authorization shapes, each as a paired <c>HtmxRoute</c> component and a
/// stock-routed twin carrying the identical metadata. Only the authorization outcome is under
/// test, so every component renders the same trivial markup. Every template carries a
/// constrained <c>{Id:int}</c> parameter because the still-active #93 template limit (lifted
/// separately by #286) requires one; it is not part of what #284 changes.
/// </summary>
internal static class Issue284Markup
{
	public static void Render(RenderTreeBuilder builder)
	{
		builder.OpenElement(0, "p");
		builder.AddAttribute(1, "data-issue-284-result", string.Empty);
		builder.AddContent(2, "ok");
		builder.CloseElement();
	}
}

internal static class Issue284Policy
{
	public const string Name = "issue-284-access";
	public const string Role = "issue-284-admin";
	public const string ClaimType = "issue-284-access";
	public const string ClaimValue = "granted";
}

// Shape: no authorization metadata at all.
[HtmxRoute("/issue-284/none/htmx/{Id:int}", Methods = ["GET"])]
public sealed class Issue284NoneHtmxPage : ComponentBase
{
	[Parameter]
	public int Id { get; set; }

	protected override void BuildRenderTree(RenderTreeBuilder builder) => Issue284Markup.Render(builder);
}

[Route("/issue-284/none/stock/{Id:int}")]
public sealed class Issue284NoneStockPage : ComponentBase
{
	[Parameter]
	public int Id { get; set; }

	protected override void BuildRenderTree(RenderTreeBuilder builder) => Issue284Markup.Render(builder);
}

// Shape: bare [Authorize].
[HtmxRoute("/issue-284/bare/htmx/{Id:int}", Methods = ["GET"])]
[Authorize]
public sealed class Issue284BareHtmxPage : ComponentBase
{
	[Parameter]
	public int Id { get; set; }

	protected override void BuildRenderTree(RenderTreeBuilder builder) => Issue284Markup.Render(builder);
}

[Route("/issue-284/bare/stock/{Id:int}")]
[Authorize]
public sealed class Issue284BareStockPage : ComponentBase
{
	[Parameter]
	public int Id { get; set; }

	protected override void BuildRenderTree(RenderTreeBuilder builder) => Issue284Markup.Render(builder);
}

// Shape: [Authorize(Policy = ...)].
[HtmxRoute("/issue-284/policy/htmx/{Id:int}", Methods = ["GET"])]
[Authorize(Policy = Issue284Policy.Name)]
public sealed class Issue284PolicyHtmxPage : ComponentBase
{
	[Parameter]
	public int Id { get; set; }

