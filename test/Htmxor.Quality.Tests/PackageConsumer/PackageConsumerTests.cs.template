public sealed partial class PackageConsumerTests
{
	[Fact]
	public void Service_registration_names_the_Htmxor_server_integration()
	{
		var registrationMethods = typeof(HtmxorApplicationBuilderExtensions)
			.GetMethods(BindingFlags.Public | BindingFlags.Static)
			.Select(static method => method.Name)
			.ToArray();

		Assert.Contains("AddHtmxor", registrationMethods);
		Assert.DoesNotContain("AddHtmx", registrationMethods);
	}

	[Fact]
	public void Endpoint_registration_names_the_Htmxor_server_integration()
	{
		var registrationMethods = typeof(PackageConsumerTests).Assembly
			.GetTypes()
			.SelectMany(static type => type.GetMethods(
				BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static))
			.Select(static method => method.Name)
			.Where(static name => name.StartsWith("AddHtmxor", StringComparison.Ordinal))
			.ToArray();

		Assert.Contains("AddHtmxorEndpoints", registrationMethods);
		Assert.DoesNotContain("AddHtmxorComponentEndpoints", registrationMethods);
	}

	[Fact]
	public void Package_removes_the_targeted_client_DSL_and_keeps_only_open_server_swap_values()
	{
		string[] removedClientAuthoringTypes =
		[
			"Htmxor.Constants",
			"Htmxor.HtmxTriggerSpecification",
			"Htmxor.ScrollDirection",
			"Htmxor.SwapStyleBuilder",
			"Htmxor.SwapStyleBuilderExtension",
			"Htmxor.SwapStyleExtensions",
			"Htmxor.Trigger",
			"Htmxor.TriggerBuilder",
			"Htmxor.TriggerModifierBuilder",
			"Htmxor.TriggerQueueOption",
		];
		var packageAssembly = typeof(HtmxorApplicationBuilderExtensions).Assembly;
		var exportedTypeNames = packageAssembly
			.GetExportedTypes()
			.Select(static type => type.FullName)
			.OfType<string>()
			.ToArray();
		var unexpectedSurface = exportedTypeNames
			.Intersect(removedClientAuthoringTypes, StringComparer.Ordinal);
		var reswapOverloads = typeof(HtmxResponse).GetMethods()
			.Where(static method => method.Name == nameof(HtmxResponse.Reswap))
			.ToArray();

		Assert.Empty(unexpectedSurface);
		Assert.DoesNotContain("Htmxor.SwapStyle", exportedTypeNames);
		Assert.Null(packageAssembly.GetType("Htmxor.SwapStyleExtensions"));
		Assert.DoesNotContain("Htmxor.Http.AjaxContext", exportedTypeNames);
		Assert.DoesNotContain("Htmxor.Http.LocationTarget", exportedTypeNames);
		Assert.Equal(
			[typeof(string), typeof(Uri)],
			typeof(HtmxResponse).GetMethods()
				.Where(static method => method.Name == nameof(HtmxResponse.Location))
				.Select(static method => Assert.Single(method.GetParameters()).ParameterType)
				.OrderBy(static type => type.Name));
		var reswap = Assert.Single(reswapOverloads);
		Assert.Equal(typeof(string), Assert.Single(reswap.GetParameters()).ParameterType);
		Assert.DoesNotContain(
			reswapOverloads.SelectMany(static method => method.GetParameters()),
			static parameter => parameter.ParameterType.FullName == "Htmxor.SwapStyleBuilder");
	}

	[Fact]
	public void Package_removes_legacy_status_286_contract()
	{
		var packageAssembly = typeof(HtmxResponse).Assembly;

		Assert.Null(packageAssembly.GetType("Htmxor.Http.HtmxStatusCodes"));
		Assert.DoesNotContain(
			typeof(HtmxResponse).GetMethods(),
			static method => method.Name == "StopPolling");

	}

	[Fact]
	public void Package_exposes_current_url_naming_and_core_request_surface()
	{
		Assert.All(
			typeof(HtmxResponseHeaderNames).GetFields(BindingFlags.Public | BindingFlags.Static),
			static field => Assert.IsType<string>(field.GetRawConstantValue()));

		var requestPropertyNames = typeof(HtmxRequest)
			.GetProperties(BindingFlags.Public | BindingFlags.Instance)
			.Select(static property => property.Name)
			.ToArray();
		Assert.Contains(nameof(HtmxRequest.CurrentUrl), requestPropertyNames);
		Assert.DoesNotContain("CurrentURL", requestPropertyNames);

		var headerFieldNames = typeof(HtmxRequestHeaderNames)
			.GetFields(BindingFlags.Public | BindingFlags.Static)
			.Where(static field => field.IsLiteral)
			.Select(static field => field.Name)
			.ToArray();
		Assert.Contains(nameof(HtmxRequestHeaderNames.CurrentUrl), headerFieldNames);
		Assert.DoesNotContain("CurrentURL", headerFieldNames);
		Assert.Equal(
			new[]
			{
				nameof(HtmxRequestHeaderNames.Boosted),
				nameof(HtmxRequestHeaderNames.CurrentUrl),
				nameof(HtmxRequestHeaderNames.HistoryRestoreRequest),
				nameof(HtmxRequestHeaderNames.HtmxRequest),
				nameof(HtmxRequestHeaderNames.RequestType),
				nameof(HtmxRequestHeaderNames.Source),
				nameof(HtmxRequestHeaderNames.Target),
			}.OrderBy(static name => name, StringComparer.Ordinal),
			headerFieldNames.OrderBy(static name => name, StringComparer.Ordinal));

		var routePropertyNames = typeof(HtmxRouteAttribute)
			.GetProperties(BindingFlags.Public | BindingFlags.Instance)
			.Select(static property => property.Name)
			.ToArray();
		Assert.Contains(nameof(HtmxRouteAttribute.Methods), routePropertyNames);
		Assert.Contains(nameof(HtmxRouteAttribute.CurrentUrl), routePropertyNames);
		Assert.Contains(nameof(HtmxRouteAttribute.Target), routePropertyNames);
		Assert.Contains(nameof(HtmxRouteAttribute.Targets), routePropertyNames);
		Assert.DoesNotContain("CurrentURL", routePropertyNames);

	}

}

