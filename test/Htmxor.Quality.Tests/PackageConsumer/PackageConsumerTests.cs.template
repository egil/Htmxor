	{
		await AssertDirectResponseAsync(
			ReportRequestPath,
			PackageConsumerAuthenticationHandler.ReportUserName,
			ReportHost,
			"data-issue-97-report-component",
			"data-report-request-values>42|issue-97-report-user|group-convention-preserved</p>",
