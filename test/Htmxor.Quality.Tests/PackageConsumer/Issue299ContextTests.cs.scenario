using System.ComponentModel;
using System.Reflection;
using Htmxor;
using Htmxor.Builder;
using Htmxor.Http;
using Xunit;

namespace Htmxor.PackageConsumer;

public sealed class Issue299ContextTests
{
    [Theory]
    [InlineData(typeof(HtmxContext))]
    [InlineData(typeof(HtmxRequest))]
    [InlineData(typeof(HtmxResponse))]
    [InlineData(typeof(HtmxEventArgs))]
    public void Packed_wrapper_has_no_public_constructor(Type wrapper)
    {
        Assert.Empty(wrapper.GetConstructors(BindingFlags.Public | BindingFlags.Instance));
    }

    [Fact]
    public void Generated_action_factory_is_hidden_and_declares_event_arguments()
    {
        var factory = RequireEventArgsFactory();
        Assert.Equal(EditorBrowsableState.Never, factory.GetCustomAttribute<EditorBrowsableAttribute>()?.State);
        Assert.Equal(typeof(HtmxEventArgs), factory.ReturnType);
    }

    private static MethodInfo RequireEventArgsFactory()
    {
        var method = typeof(HtmxorGeneratedComponentAction).GetMethod("CreateEventArgs",
            BindingFlags.Public | BindingFlags.Static, new[] { typeof(HtmxContext) });
        Assert.NotNull(method);
        return method;
    }

}
