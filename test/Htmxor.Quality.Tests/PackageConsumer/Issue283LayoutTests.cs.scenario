using Htmxor.PackageConsumer;
using Xunit;

namespace Htmxor.PackageConsumer;

public sealed class Issue283PackedLayoutTests
{
	[Fact]
	public async Task Minimal_sample_Home_direct_response_contains_its_inherited_layout_marker()
	{
		await using var app = await Issue283Host.StartAsync(true);
		var body = await Issue283Host.ReadAsync(app, "/issue-283/minimal-home", "partial");
		Assert.Contains("Hello, world!", body, StringComparison.Ordinal);
		Assert.Contains("data-minimal-layout-marker", body, StringComparison.Ordinal);
	}

	[Fact]
	public async Task Minimal_sample_Home_direct_response_contains_PageTitle()
	{
		await using var app = await Issue283Host.StartAsync(true);
		var body = await Issue283Host.ReadAsync(app, "/issue-283/minimal-home", "partial");
		Assert.Contains("Hello, world!", body, StringComparison.Ordinal);
		Assert.Contains("<title>Home</title>", body, StringComparison.Ordinal);
	}

	[Fact]
	public async Task Htmx_only_component_receives_imported_layout_from_the_package()
	{
		await using var app = await Issue283Host.StartAsync(true);
		var body = await Issue283Host.ReadAsync(app, "/issue-283/htmx/razor", "partial");
		Assert.Equal("<aside data-default-layout><p data-page>razor</p></aside>", body);
	}

	[Fact]
	public async Task Layout_and_component_fragments_are_selectable_together_from_the_package()
	{
		await using var app = await Issue283Host.StartAsync(true);
		var body = await Issue283Host.ReadAsync(app, "/issue-283/selection?Selection=Toasts,Form", "partial");
		Assert.Equal("<aside>toast</aside><div><input name=\"value\"></div>", body);
	}
}
