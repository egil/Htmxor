@using Microsoft.AspNetCore.Authorization

<section data-issue-97-summary-component>
    <p data-summary-request-values>@SummaryId|@HttpContext.User.Identity?.Name|@GroupMarker|@RazorCommentLikeText</p>
</section>

@code {
    private const string SummaryRoute = "/summaries/{SummaryId:int}";
    private const string SummaryMethod = "GET";
    private const string SummaryPolicy = "issue-97-summary-policy";
    private const string RazorCommentLikeText = "@*";

    [Parameter]
    public string? SummaryId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? GroupMarker
        => HttpContext.GetEndpoint()?.Metadata.GetMetadata<Issue97GroupMetadata>()?.Value;
}

@attribute [Htmxor.HtmxRoute(SummaryRoute, Methods = [ SummaryMethod ])]
@attribute [Authorize(SummaryPolicy)]
