@using Microsoft.AspNetCore.Authorization
@inject Issue100RequestProbe RequestProbe

<button hx-put="/issue-97-group/summaries/@SummaryId">No server action</button>

<section data-issue-97-summary-component>
    <p data-summary-request-values>@SummaryId|@HttpContext.User.Identity?.Name|@GroupMarker|@RazorCommentLikeText</p>
</section>

@code {
    private const string SummaryRoute = "/summaries/{SummaryId:int}";
    private const string SummaryGetMethod = "GET";
    private const string SummaryDeleteMethod = "DELETE";
    private const string SummaryPolicy = "issue-97-summary-policy";
    private const string RazorCommentLikeText = "@*";

    [Parameter]
    public string? SummaryId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? GroupMarker
        => HttpContext.GetEndpoint()?.Metadata.GetMetadata<Issue97GroupMetadata>()?.Value;

    protected override void OnInitialized()
    {
        RequestProbe.RecordInitialization();
    }

    protected override void OnParametersSet()
    {
        RequestProbe.RecordBinding();
    }
}

@attribute [Htmxor.HtmxRoute(SummaryRoute, Methods = [ SummaryGetMethod, SummaryDeleteMethod ])]
@attribute [Authorize(SummaryPolicy)]
