@page "/issue-154-marker"
@using System.Net
@using Htmxor
@using Htmxor.Http

<section data-issue-154-marker
         data-rejected-operation-count="@rejectedOperationCount"
         data-operation-count="@operationCount">
    marker classification
</section>

@if (WireProbe)
{
    <output data-issue-154-wire-probe
            data-is-htmx-request="@wireIsHtmxRequest"
            data-request-type="@wireRequestType"
            data-routing-mode="@wireRoutingMode"
            data-is-boosted="@wireIsBoosted"
            data-is-history-restore="@wireIsHistoryRestore"
            data-current-url="@wireCurrentUrl"
            data-source="@wireSource"
            data-target="@wireTarget"></output>
}

@code {
    private int rejectedOperationCount;
    private int operationCount;
    private string wireIsHtmxRequest = "null";
    private string wireRequestType = "null";
    private string wireRoutingMode = "null";
    private string wireIsBoosted = "null";
    private string wireIsHistoryRestore = "null";
    private string wireCurrentUrl = "null";
    private string wireSource = "null";
    private string wireTarget = "null";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    [SupplyParameterFromQuery(Name = "guard-response")]
    public bool GuardResponse { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "wire-probe")]
    public bool WireProbe { get; set; }

    protected override void OnParametersSet()
    {
        if (WireProbe)
        {
            var request = HttpContext.GetHtmxContext().Request;
            wireIsHtmxRequest = request.IsHtmxRequest.ToString().ToLowerInvariant();
            wireRequestType = request.RequestType?.ToString().ToLowerInvariant() ?? "null";
            wireRoutingMode = request.RoutingMode.ToString();
            wireIsBoosted = request.IsBoosted.ToString().ToLowerInvariant();
            wireIsHistoryRestore = request.IsHistoryRestoreRequest.ToString().ToLowerInvariant();
            wireCurrentUrl = request.CurrentUrl?.OriginalString ?? "null";
            wireSource = request.Source ?? "null";
            wireTarget = request.Target ?? "null";
        }

        if (!GuardResponse)
        {
            return;
        }

        var response = HttpContext.GetHtmxContext().Response;
        Action<HtmxResponse>[] operations =
        [
            candidate => candidate.StatusCode(HttpStatusCode.Created),
            candidate => candidate.EmptyBody(),
            candidate => candidate.Location("/forbidden-location"),
            candidate => candidate.PushUrl("/forbidden-push"),
            candidate => candidate.PushUrl(new Uri("/forbidden-push", UriKind.Relative)),
            candidate => candidate.PreventBrowserHistoryUpdate(),
            candidate => candidate.PreventBrowserCurrentUrlUpdate(),
            candidate => candidate.Redirect("/forbidden-redirect"),
            candidate => candidate.Redirect(new Uri("/forbidden-redirect", UriKind.Relative)),
            candidate => candidate.Refresh(),
            candidate => candidate.ReplaceUrl("/forbidden-replace"),
            candidate => candidate.ReplaceUrl(new Uri("/forbidden-replace", UriKind.Relative)),
            candidate => candidate.Reswap("acmeMorph settle:25ms"),
            candidate => candidate.Retarget("#forbidden-target"),
            candidate => candidate.Reselect("#forbidden-selection"),
            candidate => candidate.Trigger("forbidden:event"),
            candidate => candidate.Trigger("forbidden:event", new { Detail = "forbidden" }),
        ];

        operationCount = operations.Length;
        foreach (var operation in operations)
        {
            try
            {
                operation(response);
            }
            catch (InvalidOperationException)
            {
                rejectedOperationCount++;
            }
        }
    }
}
